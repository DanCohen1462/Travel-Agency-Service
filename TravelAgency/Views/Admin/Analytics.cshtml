@{
    Layout = "_Layout";
    ViewData["Title"] = "Operations Analytics";
}

<div class="container-fluid py-4" style="background-color: #f8f9fc; min-height: 100vh;">
    
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Management Insights</h2>
        <button class="btn btn-sm btn-primary shadow-sm" onclick="window.print()">
            <i class="fas fa-download fa-sm text-white-50 me-1"></i> Generate Report
        </button>
    </div>

    <div class="row g-4">

        <div class="col-xl-4 col-lg-5">
            <div class="card shadow border-0 h-100" style="border-radius: 15px;">
                <div class="card-header py-3 bg-white border-0">
                    <h6 class="m-0 font-weight-bold text-primary">Guide Assignment Status</h6>
                </div>
                <div class="card-body">
                    <div style="height: 250px;">
                        <canvas id="assignmentChart"></canvas>
                    </div>
                    <div class="mt-4 text-center small">
                        <span class="badge bg-danger p-2 me-2">Unassigned</span>
                        <span class="badge bg-primary p-2">Assigned</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7">
            <div class="card shadow border-0 h-100" style="border-radius: 15px;">
                <div class="card-header py-3 bg-white border-0">
                    <h6 class="m-0 font-weight-bold text-primary">Top 5 Destinations (By Travelers)</h6>
                </div>
                <div class="card-body">
                    <div style="height: 320px;">
                        <canvas id="popularChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow border-0" style="border-radius: 15px;">
                <div class="card-header py-3 bg-white border-0">
                    <h6 class="m-0 font-weight-bold text-primary">Instructor Workload (Number of Trips)</h6>
                </div>
                <div class="card-body">
                    <div style="height: 300px;">
                        <canvas id="guidesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // שליפת הנתונים מה-ViewBag (שימוש ב-camelCase כפי שהם עוברים ב-JSON)
    const assignData = @Html.Raw(Json.Serialize(ViewBag.UnassignedData));
    const popularData = @Html.Raw(Json.Serialize(ViewBag.PopularPackages));
    const guidesData = @Html.Raw(Json.Serialize(ViewBag.GuidesWorkload));

    // 1. גרף שיבוץ - Doughnut
    new Chart(document.getElementById('assignmentChart'), {
        type: 'doughnut',
        data: {
            labels: ['Unassigned', 'Assigned'],
            datasets: [{
                data: [assignData.unassigned, assignData.assigned],
                backgroundColor: ['#e74a3b', '#4e73df'],
                hoverOffset: 10,
                borderWidth: 0
            }]
        },
        options: {
            maintainAspectRatio: false,
            cutout: '75%',
            plugins: { legend: { display: false } }
        }
    });

    // 2. גרף יעדים פופולריים - Horizontal Bar
    new Chart(document.getElementById('popularChart'), {
        type: 'bar',
        data: {
            labels: Object.keys(popularData),
            datasets: [{
                label: 'Total Travelers',
                data: Object.values(popularData),
                backgroundColor: '#36b9cc',
                borderRadius: 5
            }]
        },
        options: {
            indexAxis: 'y', // הופך את הגרף לאופקי
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { stepSize: 1 } },
                y: { grid: { display: false } }
            }
        }
    });

    // 3. גרף עומס מדריכים - Standard Bar
    new Chart(document.getElementById('guidesChart'), {
        type: 'bar',
        data: {
            labels: Object.keys(guidesData),
            datasets: [{
                label: 'Packages Handled',
                data: Object.values(guidesData),
                backgroundColor: '#f6c23e',
                barThickness: 50
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 } },
                x: { grid: { display: false } }
            }
        }
    });
</script>