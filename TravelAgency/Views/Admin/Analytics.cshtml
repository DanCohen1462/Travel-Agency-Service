@{
Layout = "_Layout";
ViewData["Title"] = "Operations Analytics";
}

<style>
    body { background-color: #f0f2f5; }

    .page-header {
        background: linear-gradient(135deg, #1C6DD0, #00C9A7);
        padding: 3rem 0; color: white; margin-bottom: 2rem;
        border-radius: 0 0 20px 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .stat-card {
        background: #fff; border: none; border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: transform 0.3s ease;
    }

    .stat-card:hover { transform: translateY(-5px); }

    .card-title-custom {
        font-weight: 700; color: #2c3e50; font-size: 1.1rem;
        display: flex; align-items: center; gap: 10px;
    }

    .chart-container { position: relative; width: 100%; }

    .btn-report {
        background: rgba(255,255,255,0.2); border: 2px solid white;
        color: white; border-radius: 50px; padding: 8px 25px;
        font-weight: 700; transition: 0.3s;
    }

    .btn-report:hover { background: white; color: #1C6DD0; }

    .legend-dot {
        width: 12px; height: 12px; border-radius: 50%; display: inline-block; margin-right: 5px;
    }
</style>

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold mb-0">Management Insights</h1>
            <p class="opacity-75 mb-0">Real-time operational analytics and guide performance</p>
        </div>
        <button class="btn btn-report" onclick="window.print()">
            <i class="fas fa-file-export me-2"></i>Generate Report
        </button>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">

        <div class="col-xl-4 col-lg-5">
            <div class="stat-card p-4 h-100">
                <div class="card-title-custom mb-4">
                    <i class="fas fa-chart-pie text-primary"></i> Guide Assignment
                </div>
                <div class="chart-container" style="height: 250px;">
                    <canvas id="assignmentChart"></canvas>
                </div>
                <div class="d-flex justify-content-center gap-4 mt-4">
                    <div class="small fw-bold">
                        <span class="legend-dot" style="background: #e74a3b;"></span>Unassigned
                    </div>
                    <div class="small fw-bold">
                        <span class="legend-dot" style="background: #4e73df;"></span>Assigned
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7">
            <div class="stat-card p-4 h-100">
                <div class="card-title-custom mb-4">
                    <i class="fas fa-map-marked-alt text-success"></i> Top 5 Destinations
                </div>
                <div class="chart-container" style="height: 320px;">
                    <canvas id="popularChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="stat-card p-4">
                <div class="card-title-custom mb-4">
                    <i class="fas fa-users-cog text-warning"></i> Instructor Workload
                </div>
                <div class="chart-container" style="height: 350px;">
                    <canvas id="guidesChart"></canvas>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const assignData = @Html.Raw(Json.Serialize(ViewBag.UnassignedData));
    const popularData = @Html.Raw(Json.Serialize(ViewBag.PopularPackages));
    const guidesData = @Html.Raw(Json.Serialize(ViewBag.GuidesWorkload));

    const commonOptions = {
        maintainAspectRatio: false,
        plugins: { legend: { display: false } }
    };

    // 1. Assignment Chart
    new Chart(document.getElementById('assignmentChart'), {
        type: 'doughnut',
        data: {
            labels: ['Unassigned', 'Assigned'],
            datasets: [{
                data: [assignData.unassigned, assignData.assigned],
                backgroundColor: ['#e74a3b', '#4e73df'],
                borderWidth: 0,
                hoverOffset: 15
            }]
        },
        options: { ...commonOptions, cutout: '80%' }
    });

    // 2. Popular Destinations
    new Chart(document.getElementById('popularChart'), {
        type: 'bar',
        data: {
            labels: Object.keys(popularData),
            datasets: [{
                data: Object.values(popularData),
                backgroundColor: '#00C9A7',
                borderRadius: 10,
                barThickness: 25
            }]
        },
        options: {
            ...commonOptions,
            indexAxis: 'y',
            scales: {
                x: { grid: { display: false }, ticks: { stepSize: 1 } },
                y: { grid: { display: false } }
            }
        }
    });

    // 3. Guides Workload
    new Chart(document.getElementById('guidesChart'), {
        type: 'bar',
        data: {
            labels: Object.keys(guidesData),
            datasets: [{
                data: Object.values(guidesData),
                backgroundColor: '#5A189A',
                borderRadius: 10,
                barThickness: 40
            }]
        },
        options: {
            ...commonOptions,
            scales: {
                y: { beginAtZero: true, grid: { color: '#f0f0f0' }, ticks: { stepSize: 1 } },
                x: { grid: { display: false } }
            }
        }
    });
</script>