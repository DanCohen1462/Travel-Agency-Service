@model List<TravelAgency.Models.Package>

@if (Model == null || !Model.Any())
{
    <div class="p-4 text-center">
        <div class="empty-text-strong">No packages assigned to this guide.</div>
    </div>
}


else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>Destination</th>
                <th>Dates</th>
                <th>Country</th>
                <th class="text-center">Open</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="package-dest">@p.destination</td>
                    <td class="text-muted small">
                        @p.StartDate.ToShortDateString() - @p.EndDate.ToShortDateString()
                    </td>
                    <td>@(p.country ?? "-")</td>
                    <td class="text-center">
                        <a class="btn btn-sm btn-outline-primary" href="/Admin/PackageDetails?id=@p.Id">Open</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}