@model TravelAgency.Models.PackageView
@using TravelAgency.Models

@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="col-md-8 mx-auto">

        <div class="card shadow-lg" style="border-radius: 18px;">
            <div class="card-header bg-warning text-white" style="border-radius: 18px 18px 0 0;">
                <h3 class="py-2">Edit Package</h3>
            </div>

            <div class="card-body p-4">

                <form method="post"
                      asp-action="EditPackage"
                      enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <input type="hidden" name="Id" value="@Model.Id" />

                    <!-- Destination -->
                    <div class="mb-3">
                       
                        <label class="form-label fw-bold">Destination</label>
                        <input name="destination"
                               class="form-control"
                               value="@Model.destination"
                               required/>
                        <span asp-validation-for="destination" class="text-danger"></span>

                    </div>

                    <!-- Country -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Country</label>
                        <input name="country"
                               class="form-control"
                               value="@Model.country" />
                        <span asp-validation-for="country" class="text-danger"></span>

                    </div>

                    <!-- Dates -->
                    <div class="row">
                        <div class="col">
                            <label class="form-label fw-bold">Start Date</label>
                            <input type="date"
                                   name="StartDate"
                                   class="form-control"
                                   value="@Model.StartDate.ToString("yyyy-MM-dd")"
                                   required />
                            <span asp-validation-for="StartDate" class="text-danger"></span>

                        </div>

                        <div class="col">
                            <label class="form-label fw-bold">End Date</label>
                            <input type="date"
                                   name="EndDate"
                                   class="form-control"
                                   value="@Model.EndDate.ToString("yyyy-MM-dd")"
                                   required />
                            <span asp-validation-for="EndDate" class="text-danger"></span>

                        </div>
                    </div>

                    <!-- Price -->
                    <div class="mb-3 mt-3">
                        <label class="form-label fw-bold">Price ($)</label>
                        <input name="sum"
                               type="number"
                               class="form-control"
                               value="@Model.sum"
                               required />
                        <span asp-validation-for="sum" class="text-danger"></span>

                    </div>

                    <!-- Age Limit -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Age Limit</label>
                        <input name="ageLimit"
                               type="number"
                               class="form-control"
                               value="@Model.ageLimit"
                               required />
                        <span asp-validation-for="ageLimit" class="text-danger"></span>

                    </div>

                    <!-- Free Places -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Available Spots</label>
                        <input name="numFreePlaces"
                               type="number"
                               class="form-control"
                               value="@Model.numFreePlaces"
                               required />
                        <span asp-validation-for="numFreePlaces" class="text-danger"></span>

                    </div>

                    <!-- Cancellation Days -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cancellation Days</label>
                        <input name="cancelationDays"
                               type="number"
                               class="form-control"
                               value="@Model.cancelationDays" />
                        <span asp-validation-for="cancelationDays" class="text-danger"></span>

                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Category</label>
                        <select name="idCategory"
                                class="form-select"
                                required>
                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.Id"
                                        selected="@(cat.Id == Model.idCategory)">
                                    @cat.name
                                </option>
                            }
                        </select>
                        <span asp-validation-for="idCategory" class="text-danger"></span>

                    </div>

                    <!-- Existing Images -->
                    @if (ViewBag.Images != null)
                    {
                        <div class="row mt-4">
                            @foreach (var img in (List<ImagePackage>)ViewBag.Images)
                            {
                                <div class="col-md-3 text-center mb-3">
                                    <img src="@img.ImageLocation"
                                         class="img-fluid rounded"
                                         style="height:120px;object-fit:cover;" />

                                    <button type="button"
                                            class="btn btn-danger btn-sm mt-2"
                                            onclick="deleteImage(@img.Id, @Model.Id)">
                                        Delete
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <!-- Upload Images -->
                    <div class="mb-3 mt-3">
                        <label class="form-label fw-bold">Upload Images</label>
                        <input type="file"
                               name="images"
                               multiple
                               class="form-control" />
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="information"
                                  class="form-control"
                                  rows="3">@Model.information</textarea>
                        <span asp-validation-for="information" class="text-danger"></span>

                    </div>

                    <button class="btn btn-warning text-white w-100 fw-bold">
                        Save Changes
                    </button>

                </form>

            </div>
        </div>

        <a href="/Admin/PackageDetails/@Model.Id"
           class="btn btn-secondary mt-3 mb-5">
            Back
        </a>

    </div>
</div>

<script>
    function deleteImage(imageId, packageId) {
        fetch('/Admin/DeleteImage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `imageId=${imageId}&packageId=${packageId}`
        }).then(() => location.reload());
    }
</script>
