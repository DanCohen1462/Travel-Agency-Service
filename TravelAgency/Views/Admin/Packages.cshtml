@model List<TravelAgency.Models.Package>

@{
    Layout = "_Layout"; 
}

<style>
    body { background-color: #f0f2f5; }

    .page-header {
        background: linear-gradient(135deg, #1C6DD0, #00C9A7);
        padding: 3rem 0; color: white; margin-bottom: 2rem;
        border-radius: 0 0 20px 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .search-container {
        max-width: 500px; margin: -50px auto 30px; position: relative; z-index: 10;
    }

    .search-input {
        border-radius: 50px; padding: 15px 25px; border: none;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .btn-search {
        background: #5A189A; color: white; border-radius: 50px;
        padding: 10px 25px; position: absolute; right: 5px; top: 5px; border: none;
    }

    .package-card {
        background: #fff; border: none; border-radius: 20px; overflow: hidden;
        transition: all 0.3s ease; box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        height: 100%; display: flex; flex-direction: column;
    }

    .package-card:hover {
        transform: translateY(-10px); box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }

    .img-wrapper { height: 220px; position: relative; overflow: hidden; }

    .card-img-top { height: 100%; width: 100%; object-fit: cover; transition: 0.5s; }

    .package-card:hover .card-img-top { transform: scale(1.1); }

    .price-tag { font-size: 1.25rem; font-weight: 800; color: #1C6DD0; }

    .discount-badge {
        position: absolute; top: 15px; left: 15px; background: #ff4757;
        color: white; padding: 5px 12px; border-radius: 50px;
        font-weight: 700; font-size: 0.8rem; box-shadow: 0 4px 10px rgba(255, 71, 87, 0.3);
    }

    .btn-view-custom {
        border-radius: 50px; font-weight: 700; padding: 8px 20px;
        background-color: #f1f4f9; color: #1C6DD0; border: none;
    }
    .btn-view-custom:hover { background-color: #1C6DD0; color: white; }

    .btn-delete-icon {
        color: #ff4757; background: #fff1f2; width: 38px; height: 38px;
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
        border: none; transition: 0.2s;
    }
    .btn-delete-icon:hover { background: #ff4757; color: white; }
</style>

<div class="page-header text-center">
    <div class="container">
        <h1 class="fw-bold display-5">Package Gallery</h1>
        <p class="opacity-75 lead">Discover and manage all active travel journeys</p>
    </div>
</div>

<div class="container">
    <div class="search-container">
        <form method="get" class="d-flex position-relative">
            <input type="text" name="search" class="form-control search-input" 
                   placeholder="Where to?" value="@ViewBag.Search" />
            <button class="btn btn-search fw-bold">Search</button>
        </form>
    </div>

    <div class="row g-4 mb-5">
        @foreach (var pkg in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="package-card">
                    <div class="img-wrapper">
                        <img src="@pkg.RandomImage" class="card-img-top" alt="@pkg.destination" />
                        @if (pkg.ActiveDiscount > 0)
                        {
                            <div class="discount-badge">@pkg.ActiveDiscount% OFF</div>
                        }
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <div class="mb-2">
                            <small class="text-uppercase fw-bold text-muted letter-spacing-1">@pkg.country</small>
                            <h4 class="fw-bold text-dark mt-1 mb-0">@pkg.destination</h4>
                        </div>
                        
                        <p class="text-muted small mb-4">
                            <i class="fa-regular fa-calendar-days me-1"></i>
                            @pkg.StartDate.ToShortDateString() - @pkg.EndDate.ToShortDateString()
                        </p>

                        <div class="mt-auto">
                            <div class="d-flex align-items-end justify-content-between mb-3">
                                <div class="price-display">
                                    @if (pkg.ActiveDiscount > 0)
                                    {
                                        var discountPrice = pkg.sum - (pkg.sum * pkg.ActiveDiscount / 100);
                                        <div class="text-muted text-decoration-line-through small mb-n1">$@pkg.sum</div>
                                        <div class="price-tag text-success">$@discountPrice</div>
                                    }
                                    else
                                    {
                                        <div class="price-tag">$@pkg.sum</div>
                                    }
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <a href="/Admin/PackageDetails/@pkg.Id" class="btn btn-view-custom">
                                    View Details
                                </a>

                                <form method="post" action="/Admin/DeletePackage" class="d-inline">
                                    <input type="hidden" name="id" value="@pkg.Id" />
                                    <button type="submit" class="btn-delete-icon"
                                            onclick="return confirm('Are you sure you want to delete this package?');">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>