@model Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-header bg-white border-0 pt-4 text-center">
                    <h3 class="fw-bold"><i class="fas fa-edit me-2 text-primary"></i>Edit Category</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditCategory" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label asp-for="name" class="form-label fw-bold">Category Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-tag text-muted"></i></span>
                                <input asp-for="name" class="form-control bg-light" placeholder="Enter category name" />
                            </div>
                            <span asp-validation-for="name" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                            <a asp-action="CategoryIndex" class="btn btn-outline-secondary w-100 py-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>