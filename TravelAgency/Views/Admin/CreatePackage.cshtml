@model Package

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}



<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-lg" style="border-radius: 18px;">
                <div class="card-header text-center bg-primary text-white" style="border-radius: 18px 18px 0 0;">
                    <h3 class="py-2">Create New Package</h3>
                </div>

                <div class="card-body p-4">

                    <form asp-action="CreatePackage" method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Destination</label>
                            <span asp-validation-for="destination" class="text-danger"></span>
                            <input asp-for="destination" class="form-control" placeholder="e.g. Paris, France" required />
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Country</label>
                            <span asp-validation-for="country" class="text-danger"></span>

                            <input asp-for="country" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Start Date</label>
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">End Date</label>
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                            <input asp-for="EndDate" type="date" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Total Price ($)</label>
                            <span asp-validation-for="sum" class="text-danger"></span>
                            <input asp-for="sum" type="number" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Age Limit</label>
                            <span asp-validation-for="ageLimit" class="text-danger"></span>
                            <input asp-for="ageLimit" type="number" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Available Spots</label>
                            <span asp-validation-for="numFreePlaces" class="text-danger"></span>
                            <input asp-for="numFreePlaces" type="number" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Category</label>
                            <span asp-validation-for="idCategory" class="text-danger"></span>
                            <select asp-for="idCategory" class="form-select" required>
                                <option disabled>Select a category...</option>
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    <option value="@cat.Id">@cat.name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Upload Images</label>
                            <input type="file" name="images" class="form-control" accept="image/*" multiple />
                        </div>
                        
                        @if (ViewBag.Images != null && ViewBag.Images.Count > 0)
                        {
                            <label class="fw-bold mt-3">Images from original package:</label>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var img in ViewBag.Images)
                                {
                                    <img src="@img.ImageLocation"
                                         style="width:120px;height:80px;object-fit:cover;border-radius:6px;" />

                                    <!-- חשוב! מעביר את התמונה ל-POST -->
                                    <input type="hidden" name="duplicateImgPaths" value="@img.ImageLocation" />
                                }
                            </div>
                        }


                        <div class="mb-3">
                            <label class="form-label fw-bold">Cancellation Day</label>
                            <span asp-validation-for="cancelationDays" class="text-danger"></span>
                            <input asp-for="cancelationDays" type="number" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Description</label>
                            <span asp-validation-for="information" class="text-danger"></span>
                            <textarea asp-for="information" class="form-control" rows="3" required></textarea>
                        </div>

                        <!-- Submit Button -->
                        <button class="btn btn-primary w-100 py-2 fw-bold mb-5" style="font-size: 1.1rem;">
                            Create Package
                        </button>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        animation: fadeIn 0.4s ease-out;
    }


</style>

