@model TravelAgency.Models.UserProfileViewModel

@{
    ViewData["Title"] = "Profile";
    Layout = "_Layout";
}

<style>
    body { background-color: #f0f2f5; }

    .page-header {
        background: linear-gradient(135deg, #1C6DD0, #00C9A7);
        padding: 3rem 0;
        color: white;
        margin-bottom: 1rem; /* smaller gap */
        border-radius: 0 0 20px 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .content-wrap { margin-top: -0.5rem; } /* pull content closer */

    .btn-purple {
        background: #5A189A;
        color: #fff !important;
        border: 1px solid #5A189A;
        text-decoration: none !important;
        white-space: nowrap;
    }
    .btn-purple:hover{
        background: #4B147F;
        border-color: #4B147F;
    }
</style>

<div class="page-header text-center">
    <div class="container">
        <h1 class="fw-bold display-5">My Profile</h1>
        <p class="opacity-75 lead">Manage your account settings and personal information</p>
    </div>
</div>

<div class="container pb-5 content-wrap">


    <div class="row justify-content-center">
        <div class="col-md-11 col-lg-9 col-xl-8">

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.Success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- removed the blue inner header bar -->
                <div class="card-body p-4 p-md-5 p-lg-5">

                    
                    <div class="text-center mt-n5 mb-4 position-relative">
                        <div class="bg-white rounded-circle shadow p-1 d-inline-block">
                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-secondary" viewBox="0 0 16 16">
                                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.Type)

                        <h5 class="text-muted mb-3 border-bottom pb-2">Account Details</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label fw-semibold text-secondary small">Username</label>
                                <input asp-for="Username" class="form-control" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary small">Email Address</label>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="text-muted mb-3 border-bottom pb-2">Personal Information</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold text-secondary small">First Name</label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold text-secondary small">Last Name</label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold text-secondary small">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BirthDate" class="form-label fw-semibold text-secondary small">Date of Birth</label>
                                <input asp-for="BirthDate" class="form-control" type="date" />
                                <span asp-validation-for="BirthDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Gender" class="form-label fw-semibold text-secondary small">Gender</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">Select...</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-column align-items-end gap-3 mt-4 pt-3 border-top">
                            <a asp-controller="Auth" asp-action="ChangePassword" class="btn btn-purple px-4" style="min-width:220px;">
                                <i class="bi bi-key me-1"></i> Change Password
                            </a>
                            <button type="submit" class="btn btn-purple px-4 shadow-sm" style="min-width:220px;">
                                Save Changes
                            </button>
                        </div>



                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}