@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = "_Layout";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

@{
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "Customer";
}

<style>
    .user-card {
        border-radius: 15px;
        transition: transform 0.2s, box-shadow 0.2s;
        border-left: 5px solid #1C6DD0;
        text-align: center;
    }
    .user-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15) !important;
    }
    .card-icon { color: #1C6DD0; }
    .card-trip { border-left-color: #1C6DD0; }
    .card-search { border-left-color: #0dcaf0; }
    .card-profile { border-left-color: #ffc107; }
    .card-cart { border-left-color: #198754; }
    .card-notifications { border-left-color: #dc3545; }
</style>

<h2 class="fw-bold mb-4 text-primary">👋 Welcome Back, @fullName!</h2>
<hr/>
<h4 class="mb-4 text-secondary">Your Travel Quick Access Panel</h4>

<div class="row g-4">

    <div class="col-lg-4 col-md-6">
        <a asp-controller="Users" asp-action="MyTrips" class="card text-decoration-none h-100 shadow-sm user-card card-trip">
            <div class="card-body p-4">
                <i class="fas fa-suitcase-rolling fa-3x mb-3 card-icon"></i>
                <h5 class="card-title fw-bold">1. My Trips</h5>
                <p class="card-text text-muted">View all your active and past reservations.</p>
            </div>
        </a>
    </div>

    <div class="col-lg-4 col-md-6">
        <a asp-controller="Package" asp-action="SearchStart" class="card text-decoration-none h-100 shadow-sm user-card card-search">
            <div class="card-body p-4">
                <i class="fas fa-globe-americas fa-3x mb-3 card-icon" style="color: #0dcaf0;"></i>
                <h5 class="card-title fw-bold">2. Search Trip</h5>
                <p class="card-text text-muted">Search & filter available travel packages.</p>
            </div>
        </a>
    </div>

    <div class="col-lg-4 col-md-6">
        <a asp-controller="Cart" asp-action="Index" class="card text-decoration-none h-100 shadow-sm user-card card-cart">
            <div class="card-body p-4">
                <i class="fas fa-shopping-cart fa-3x mb-3 card-icon" style="color: #198754;"></i>
                <h5 class="card-title fw-bold">3. My Cart</h5>
                <p class="card-text text-muted">Review items added to your booking cart.</p>
            </div>
        </a>
    </div>

    <div class="col-lg-4 col-md-6">
        <a asp-controller="Users" asp-action="Profile" class="card text-decoration-none h-100 shadow-sm user-card card-profile">
            <div class="card-body p-4">
                <i class="fas fa-user-circle fa-3x mb-3 card-icon" style="color: #ffc107;"></i>
                <h5 class="card-title fw-bold">4. My Profile</h5>
                <p class="card-text text-muted">Update your personal details and settings.</p>
            </div>
        </a>
    </div>

    <div class="col-lg-4 col-md-6">
        <a asp-controller="Notifications" asp-action="Index" class="card text-decoration-none h-100 shadow-sm user-card card-notifications">
            <div class="card-body p-4">
                <i class="fas fa-bell fa-3x mb-3 card-icon" style="color: #dc3545;"></i>
                <h5 class="card-title fw-bold">5. Notifications</h5>
                <p class="card-text text-muted">View system alerts and updates.</p>
            </div>
        </a>
    </div>

    <div class="col-lg-4 col-md-6">
        <a asp-controller="Home" asp-action="ContactUs" class="card text-decoration-none h-100 shadow-sm user-card" style="border-left-color: #6c757d;">
            <div class="card-body p-4">
                <i class="fas fa-headset fa-3x mb-3 card-icon" style="color: #6c757d;"></i>
                <h5 class="card-title fw-bold">6. Contact Us</h5>
                <p class="card-text text-muted">Get assistance from our support team.</p>
            </div>
        </a>
    </div>

</div>
