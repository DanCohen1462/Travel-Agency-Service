@{
    ViewBag.Title = "Your Cart";
    Layout = "_Layout";

    var id = ViewBag.Id ?? 0;

    string title = "";
    string category = "";
    string dates = "";
    decimal basePrice = 0;
    string image = "";

    if ((int)id == 101)
    {
        title = "Paris – 5 Days";
        category = "Honeymoon";
        dates = "12/03/2025 - 17/03/2025";
        basePrice = 899;
        image = "paris.jpg";
    }
    else if ((int)id == 202)
    {
        title = "Rome – 4 Days";
        category = "Adventure";
        dates = "01/04/2025 - 05/04/2025";
        basePrice = 750;
        image = "Roma.jpeg";   // שים לב לשם!
    }
    else
    {
        title = "London – 6 Days";
        category = "Family";
        dates = "20/04/2025 - 26/04/2025";
        basePrice = 1150;
        image = "london.jpg";
    }

    var tax = basePrice * 0.17m;
    var total = basePrice + tax;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #F6F7FB;
    }

    .cart-container {
        margin-top: 40px;
        margin-bottom: 40px;
    }
    .btn-delete {
        background: #ff4d4d;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-delete:hover {
        background: #e60000;
    }

    .cart-card {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        padding: 25px;
    }

    .cart-img {
        width: 100%;
        height: 220px;
        border-radius: 15px;
        object-fit: cover;
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
    }

    .cart-title {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .badge-category {
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
    }

    .summary-box {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        padding: 25px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 16px;
    }

    .summary-total {
        font-size: 22px;
        font-weight: 700;
        color: #1C6DD0;
    }

    .btn-checkout,
    .btn-keep {
        width: 100%;
        border-radius: 12px;
        padding: 12px;
        font-size: 18px;
        font-weight: 600;
        border: none;
        transition: 0.2s;
    }

    .btn-checkout {
        background: #1C6DD0;
        color: white;
    }

    .btn-checkout:hover {
        background: #155BB4;
    }

    .btn-keep {
        background: #EEF1F6;
        color: #1C1C1C;
        margin-top: 10px;
    }

    .btn-keep:hover {
        background: #E0E4EC;
    }
</style>

<div class="container cart-container">
    <h2 class="mb-4 fw-bold">Your Cart</h2>

    <div class="row g-4">
        <!-- LEFT: CART ITEM -->
        <div class="col-md-8">
            <div class="cart-card">
                <div class="row g-3 align-items-center">
                    <div class="col-md-5">
                        <img src="/images/@image" alt="@title" class="cart-img" />
                    </div>
                    <div class="col-md-7">
                        <div class="cart-title">@title</div>

                        <span class="badge bg-primary badge-category">@category</span>

                        <p class="mt-3 mb-1"><strong>Dates:</strong> @dates</p>
                        <p class="mb-1"><strong>Age Limit:</strong> 16+</p>
                        <p class="mb-1"><strong>Rooms Left:</strong> @((id == 101 ? 5 : id == 202 ? 3 : 7))</p>

                        <p class="mt-3 mb-0">
                            <strong>Package ID:</strong> #@id
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: SUMMARY -->
        <div class="col-md-4">
            <div class="summary-box">
                <h4 class="mb-3">Order Summary</h4>

                <div class="summary-row">
                    <span>Package price</span>
                    <span>$@basePrice</span>
                </div>

                <div class="summary-row">
                    <span>Tax (17%)</span>
                    <span>$@tax.ToString("0")</span>
                </div>

                <hr />

                <div class="summary-row summary-total">
                    <span>Total</span>
                    <span>$@total.ToString("0")</span>
                </div>

                <a asp-controller="Home" asp-action="Payment" class="btn-checkout mt-3 d-block text-center">
                    Proceed to Checkout
                </a>                <a asp-controller="Home" asp-action="Gallery" class="btn-keep text-center text-decoration-none">
                    ← Keep browsing packages
                </a>
                
                <div class="d-flex gap-3 mt-3">
                    
                    <button class="btn-delete">🗑️ Remove</button>
                </div>
                
            </div>
        </div>
    </div>
</div>
