@{
    ViewBag.Title = "Payment";
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #F5F7FA;
    }

    .payment-card {
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.10);
        max-width: 550px;
        margin: auto;
        margin-top: 50px;
    }

    .payment-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #1C6DD0;
    }

    .credit-input {
        height: 52px;
        border-radius: 12px;
        font-size: 18px;
    }

    .warning-box {
        background: #FFF4D8;
        padding: 15px;
        border-radius: 12px;
        margin-top: 15px;
        font-size: 15px;
    }

    .btn-pay {
        background: #1C6DD0;
        color: white;
        width: 100%;
        border-radius: 12px;
        padding: 14px;
        font-size: 20px;
        font-weight: 600;
        border: none;
        transition: 0.2s;
    }

    .btn-pay:hover {
        background: #155BB4;
    }

    .btn-back-cart, .btn-back-gallery {
        width: 100%;
        padding: 12px;
        border-radius: 12px;
        font-size: 17px;
        font-weight: 600;
        transition: 0.2s;
        text-decoration: none;
        display: block;
        text-align: center;
        margin-top: 12px;
    }

    .btn-back-cart {
        background: #E5E7EB;
        color: #000;
    }

    .btn-back-cart:hover {
        background: #D1D5DB;
    }

    .btn-back-gallery {
        background: #F3F4F6;
        color: #000;
    }

    .btn-back-gallery:hover {
        background: #E5E7EB;
    }
</style>


<div class="payment-card">

    <h2 class="payment-title">Secure Payment</h2>

    <form>

        <label class="form-label">Full Name on Card</label>
        <input type="text" class="form-control credit-input" placeholder="John Doe" required />

        <label class="form-label mt-3">Credit Card Number</label>
        <input type="text" class="form-control credit-input" maxlength="16" placeholder="1234 5678 9012 3456" required />

        <div class="row mt-3">
            <div class="col-md-6">
                <label class="form-label">Expiration (MM/YY)</label>
                <input type="text" class="form-control credit-input" maxlength="5" placeholder="12/27" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">CVV</label>
                <input type="text" class="form-control credit-input" maxlength="3" placeholder="123" required />
            </div>
        </div>

        <div class="warning-box mt-3">
            ⚠️ פרטי האשראי **לא נשמרים** בשום מערכת ואינם מאוחסנים.  
            הפעולה מדמה תשלום בלבד.
        </div>

        <button class="btn-pay mt-4">Complete Payment</button>

    </form>

    <a asp-controller="Home" asp-action="Cart" class="btn-back-cart">
        ← Back to Cart
    </a>

    <a asp-controller="Home" asp-action="PackageDetails" class="btn-back-gallery">
        ← Back to Gallery
    </a>

</div>
