@using Microsoft.Data.SqlClient
@inject IConfiguration Config
@model TravelAgency.Models.PaymentViewModel


@{
    ViewBag.Title = "Payment";
    Layout = "_Layout";

    // ✅ הוספה: חישוב סכום כולל מה-shoppingcart (inactive=0)
    var userIdStr = Context.Session.GetString("UserId");
    int totalPrice = 0;

    if (int.TryParse(userIdStr, out int uid))
    {
        using var conn = new SqlConnection(Config.GetConnectionString("DefaultConnection"));
        conn.Open();

        using var cmd = new SqlCommand(@"
            SELECT ISNULL(SUM(sum),0)
            FROM shoppingcart
            WHERE userId=@uid AND inactive=0;", conn);

        cmd.Parameters.AddWithValue("@uid", uid);
        totalPrice = (int)cmd.ExecuteScalar();
    }

    ViewBag.TotalPrice = totalPrice;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #F5F7FA;
    }

    .payment-card {
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.10);
        max-width: 550px;
        margin: auto;
        margin-top: 50px;
    }

    .payment-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #1C6DD0;
    }

    .credit-input {
        height: 52px;
        border-radius: 12px;
        font-size: 18px;
    }

    .warning-box {
        background: #FFF4D8;
        padding: 15px;
        border-radius: 12px;
        margin-top: 15px;
        font-size: 15px;
    }

    .btn-pay {
        background: #1C6DD0;
        color: white;
        width: 100%;
        border-radius: 12px;
        padding: 14px;
        font-size: 20px;
        font-weight: 600;
        border: none;
        transition: 0.2s;
    }

    .btn-pay:hover {
        background: #155BB4;
    }

    .btn-back-cart, .btn-back-gallery {
        width: 100%;
        padding: 12px;
        border-radius: 12px;
        font-size: 17px;
        font-weight: 600;
        transition: 0.2s;
        text-decoration: none;
        display: block;
        text-align: center;
        margin-top: 12px;
    }

    .btn-back-cart {
        background: #E5E7EB;
        color: #000;
    }

    .btn-back-cart:hover {
        background: #D1D5DB;
    }

    .btn-back-gallery {
        background: #F3F4F6;
        color: #000;
    }

    .btn-back-gallery:hover {
        background: #E5E7EB;
    }
</style>


<div class="payment-card">

    <h2 class="payment-title">Secure Payment</h2>

    @* ✅ הודעות הצלחה/כישלון *@
    @if (TempData["PaymentError"] != null)
    {
        <div class="alert alert-danger">@TempData["PaymentError"]</div>
    }
    @if (TempData["PaymentSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["PaymentSuccess"]</div>
    }

    @* ✅ שימי לב: שיניתי את ה-action מ-MarkPaid ל-Payment כדי שהולידציות יעבדו *@
    <form method="post" asp-controller="Cart" asp-action="Payment">

        <label class="form-label">Full Name on Card</label>
        <input asp-for="FullName" class="form-control credit-input" placeholder="John Doe" />
        <span asp-validation-for="FullName" class="text-danger"></span>

        <label class="form-label mt-3">Credit Card Number</label>
        <input asp-for="CardNumber" class="form-control credit-input" maxlength="16" placeholder="1234567890123456" />
        <span asp-validation-for="CardNumber" class="text-danger"></span>

        <div class="row mt-3">
            <div class="col-md-6">
                <label class="form-label">Expiration (MM/YY)</label>
                <input asp-for="Expiration" class="form-control credit-input" maxlength="5" placeholder="12/27" />
                <span asp-validation-for="Expiration" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">CVV</label>
                <input asp-for="CVV" class="form-control credit-input" maxlength="3" placeholder="123" />
                <span asp-validation-for="CVV" class="text-danger"></span>
            </div>
        </div>

        <div class="warning-box mt-3">
            ⚠️ פרטי האשראי **לא נשמרים** בשום מערכת ואינם מאוחסנים.
            הפעולה מדמה תשלום בלבד.
        </div>

        @if (ViewBag.TotalPrice != null)
        {
            <div class="alert alert-info">
                <strong>Total amount:</strong> $@ViewBag.TotalPrice
            </div>
        }

        <button type="submit" class="btn-pay mt-4">Complete Payment</button>

    </form>


    <a asp-controller="Cart" asp-action="Index" class="btn-back-cart">← Back to Cart</a>

    <a asp-controller="Package" asp-action="Gallery" class="btn-back-gallery">← Back to Gallery</a>

</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
