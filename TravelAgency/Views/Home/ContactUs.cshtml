@model TravelAgency.Models.ContactFormViewModel

@{
    ViewData["Title"] = "Contact";
    Layout = "_Layout";
}

<style>
    /* ===== Hero Background ===== */
    .contact-hero-section {
        background-image: url('https://images.unsplash.com/photo-1526772662000-3f88f10405ff?q=80&w=2000');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding: 120px 20px;
        position: relative;
        border-radius: 18px;
        overflow: hidden;
        margin-bottom: 40px;
    }

    .contact-hero-section::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 1;
    }

    .contact-hero-content {
        position: relative;
        z-index: 2;
        color: white;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    }

    .contact-title {
        font-size: 2.6rem;
        font-weight: 800;
    }

    .contact-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .contact-info-pill {
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(8px);
        padding: 10px 18px;
        font-size: 0.95rem;
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: white;
    }

    .contact-card {
        border-radius: 18px;
        border: none;
        box-shadow: 0 12px 30px rgba(0,0,0,0.1);
        max-width: 900px;      /* לא לגלוש מעבר למסך */
        margin: 0 auto;
    }

    .contact-label {
        font-weight: 600;
    }

    .contact-input, .contact-textarea {
        border-radius: 12px;
        border: 1px solid #ddd;
    }

    .contact-btn {
        border-radius: 999px;
        padding: 10px 26px;
        font-weight: 600;
        font-size: 1rem;
    }

    @@media (max-width: 768px) {
        .contact-title {
            font-size: 2rem;
            text-align: center;
        }
    }
</style>

<div class="container mt-4">

    <!-- ===== Hero Section ===== -->
    <div class="contact-hero-section">
        <div class="contact-hero-content">
            <h1 class="contact-title mb-3">Contact Our Travel Experts</h1>
            <p class="contact-subtitle mb-4">
                Let us help you plan your next dream vacation — in Israel or around the world!
            </p>
            <div class="d-flex flex-wrap gap-2">
                <div class="contact-info-pill">✈️ Tailored worldwide trips</div>
                <div class="contact-info-pill">🌍 Local & global travel experts</div>
                <div class="contact-info-pill">🕒 Fast 24h response</div>
            </div>
        </div>
    </div>

    <!-- ===== Contact Form ===== -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card contact-card p-4 p-md-5">
                <h4 class="mb-3">Send us a message</h4>
                <p class="text-muted mb-4" style="font-size:0.95rem;">
                    Tell us about the vacation you're dreaming of — and we’ll take care of the rest.
                </p>

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success">@ViewBag.Success</div>
                }

                <form method="post" asp-controller="Home" asp-action="ContactUs">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="contact-label">Full Name</label>
                            <input asp-for="FullName" class="form-control contact-input" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="contact-label">Email</label>
                            <input asp-for="Email" class="form-control contact-input" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="contact-label">Phone</label>
                            <input asp-for="Phone" class="form-control contact-input" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="contact-label">Preferred Destination</label>
                            <input asp-for="Destination" class="form-control contact-input" placeholder="Paris, Rome, Eilat..." />
                            <span asp-validation-for="Destination" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="contact-label">Message</label>
                        <textarea asp-for="Message" rows="4" class="form-control contact-textarea"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between flex-wrap">
                        <button type="submit" class="btn btn-success contact-btn">Send Message</button>
                        <small class="text-muted mt-2">We will never share your details.</small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
