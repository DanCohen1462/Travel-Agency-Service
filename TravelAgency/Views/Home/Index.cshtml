@{
    ViewBag.Title = "Home";
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #F5F7FA;
    }

    /* --- HERO IMAGE --- */
    .hero-img {
        width: 100%;
        height: 450px;
        object-fit: cover;
        object-position: center;
        border-radius: 20px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }

    .hero-container {
        margin-top: 40px;
        margin-bottom: 40px;
    }

    /* --- SEARCH BAR --- */
    .search-box {
        background: white;
        padding: 25px;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        margin-top: -50px;
        position: relative;
        z-index: 2;
    }

    .search-box input {
        height: 52px;
        border-radius: 12px;
        font-size: 18px;
    }

    .search-box button {
        height: 52px;
        border-radius: 12px;
        background: #1C6DD0;
        color: white;
        font-size: 18px;
        font-weight: 600;
        padding: 0 25px;
    }

    /* --- REVIEWS SECTION --- */
    .reviews-section {
        padding: 60px 0;
        margin-bottom: 100px;
    }

    .review-card {
        background: white;
        border-radius: 18px;
        padding: 25px;
        min-height: 200px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.09);
    }

    .stars {
        font-size: 20px;
        color: #FFD700;
    }

    .rating-number {
        font-size: 48px;
        font-weight: 700;
        color: #1C6DD0;
    }
</style>


<!-- ================= HERO (ONLY ONE IMAGE) ================= -->
<div class="container hero-container">
    <img 
        src="https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=1600&q=80"
        class="hero-img" 
        alt="Paris">
</div>


<!-- ================= SEARCH BAR ================= -->
<div class="container search-box">
    <form method="get" asp-controller="Home" asp-action="Gallery">
        <div class="row g-3">
            <div class="col-md-9">
                <input name="destination" class="form-control" placeholder="Where do you want to travel? (Paris, Rome, London...)">
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit">Search</button>
            </div>
        </div>
    </form>
</div>


<!-- ================= REVIEWS ================= -->
<section class="reviews-section container">
    <h2 class="mb-4">What our travelers say</h2>

    <!-- Rating -->
    <div class="text-center mb-4">
        <div class="rating-number">4.5 ⭐</div>
        <p class="text-muted">Based on 1,248 reviews</p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="review-card">
                <div class="stars">⭐⭐⭐⭐⭐</div>
                <p>"שירות מדהים! כל הטיול היה מתוקתק עד הפרט האחרון. נחזור שוב!"</p>
                <strong>— יעל כהן</strong>
            </div>
        </div>

        <div class="col-md-4">
            <div class="review-card">
                <div class="stars">⭐⭐⭐⭐☆</div>
                <p>"חופשה מושלמת בפריז. צוות מקצועי ואכפתי. ממליץ בחום."</p>
                <strong>— ניר אלקיים</strong>
            </div>
        </div>

        <div class="col-md-4">
            <div class="review-card">
                <div class="stars">⭐⭐⭐⭐⭐</div>
                <p>"זמינות מדהימה, מחיר הוגן וחווית טיסה מדהימה. תודה ענקית!"</p>
                <strong>— דנה רוזנברג</strong>
            </div>
        </div>

    </div>
</section>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>