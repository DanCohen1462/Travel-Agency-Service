@{
    ViewBag.Title = "Employee Home";
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    /* העתקתי את אותו עיצוב בדיוק מהקובץ ששלחת */
    body { background: #F5F7FA; }
    .home-section { margin: 60px 0; }

    /* ===== HERO ===== */
    .hero-wrapper {
        margin-top: 50px;
        margin-bottom: 50px;
        border-radius: 28px;
        overflow: hidden;
        position: relative;
        box-shadow: 0 18px 45px rgba(0,0,0,0.18);
    }
    .hero-img {
        width: 100%;
        height: 380px;
        object-fit: cover;
        filter: brightness(0.55);
    }
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(120deg, rgba(19,184,166,0.75), rgba(15,110,140,0.95));
    }
    .hero-content {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 36px 50px;
        color: #ffffff;
        z-index: 1;
    }
    .hero-badge {
        background: rgba(255,255,255,0.14);
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 13px;
        margin-bottom: 10px;
        max-width: fit-content;
    }
    .hero-title {
        font-size: 40px;
        font-weight: 800;
        margin-bottom: 10px;
    }
    .hero-subtitle {
        font-size: 16px;
        max-width: 460px;
        margin-bottom: 22px;
    }
    .hero-buttons .btn {
        border-radius: 999px;
        padding: 11px 28px;
        font-size: 16px;
        font-weight: 600;
        margin-right: 12px;
    }
    .btn-hero-primary { background: #ffffff; color: #0B4255; }
    .btn-hero-outline { border: 2px solid #ffffff; color: #ffffff; background: transparent; }
    .btn-hero-outline:hover { background: #ffffff22; }

    /* ===== TITLES ===== */
    .section-title { font-size: 26px; font-weight: 700; margin-bottom: 12px; color: #0B4255; text-align: center; }
    .section-subtitle { color: #6c757d; margin-bottom: 26px; text-align: center; }

    /* ===== OUR SERVICE ===== */
    .service-section { position: relative; }
    .service-card {
        background: #0B4255; color: #ffffff; border-radius: 28px; padding: 34px 32px;
        box-shadow: 0 16px 40px rgba(0,0,0,0.18); text-align: center;
    }
    .service-pill-title { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
    .service-pill-text { font-size: 14px; opacity: 0.93; }

    /* ===== TRAVEL TYPES ===== */
    .travel-types-section { position: relative; overflow: visible; }
    .types-wrapper { max-width: 900px; margin: 0 auto; }
    .type-pill {
        display: flex; justify-content: space-between; padding: 11px 18px; border-radius: 999px;
        margin-bottom: 10px; background: linear-gradient(90deg, #13B8A6, #0F6E8C);
        color: #ffffff; box-shadow: 0 10px 26px rgba(0,0,0,0.12); font-size: 14px;
    }
    .type-name { font-weight: 700; }
    .type-desc { font-size: 13px; opacity: 0.94; }

    /* ===== GLOBAL DECOR ICONS ===== */
    .decor-icon { position: absolute; font-size: 90px; opacity: 0.10; pointer-events: none; color: #06334a; z-index: 0; }
    .hero-icon-plane { top: -20px; right: -20px; transform: rotate(15deg); }
    .service-icon-person { left: -35px; top: 50%; transform: translateY(-50%); }
    .types-icon-map { right: -35px; top: 45%; transform: translateY(-50%); }
    .dest-icon-camera { bottom: -25px; left: -20px; }
    .reviews-icon-plane { top: -10px; right: -15px; font-size: 70px; }
    .quote-icon-person { bottom: -15px; left: -15px; font-size: 70px; }

    /* ===== POPULAR DESTINATIONS ===== */
    .popular-section { position: relative; overflow: visible; }
    .polaroid-card {
        background: #ffffff; border-radius: 18px; padding: 10px 10px 16px 10px;
        box-shadow: 0 14px 32px rgba(0,0,0,0.18); transform: rotate(-1deg);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .polaroid-card:nth-child(2) { transform: rotate(2deg); }
    .polaroid-card:nth-child(3) { transform: rotate(-2deg); }
    .polaroid-card:nth-child(4) { transform: rotate(1deg); }
    .polaroid-card:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(0,0,0,0.24); }
    .polaroid-img { width: 100%; height: 170px; object-fit: cover; border-radius: 12px; margin-bottom: 8px; }
    .polaroid-caption { text-align: center; font-weight: 700; color: #0B4255; }

    /* ===== REVIEWS ===== */
    .reviews-section { padding: 40px 0 70px 0; position: relative; }
    .rating-number { font-size: 44px; font-weight: 800; color: #0F6E8C; }
    .stars { font-size: 20px; color: #FFD700; }
    .review-card {
        background: #ffffff; border-radius: 24px; padding: 22px; min-height: 180px;
        box-shadow: 0 10px 28px rgba(0,0,0,0.08); text-align: center;
    }

    /* ===== QUOTE ===== */
    .quote-section {
        border-radius: 28px; background: #0B4255; color: #ffffff; padding: 40px 30px;
        margin-bottom: 80px; text-align: center; box-shadow: 0 14px 36px rgba(0,0,0,0.18);
        position: relative; overflow: hidden;
    }
    .quote-main { font-size: 24px; font-weight: 700; max-width: 650px; margin: 0 auto; }
    .quote-sub { font-size: 14px; opacity: 0.9; margin-top: 10px; }
    .quote-line { height: 3px; width: 130px; background: #13B8A6; margin: 18px auto 0; }

    @@media (max-width: 768px) {
        .hero-content { padding: 24px 20px; text-align: center; align-items: center; }
        .hero-title { font-size: 32px; }
        .hero-subtitle { font-size: 16px; }
        .hero-buttons { justify-content: center; }
    }
</style>

<div class="container">

    <section class="hero-wrapper">
        <img src="https://images.unsplash.com/photo-1526779259212-939e64788e3c?auto=format&fit=crop&w=1600&q=80"
             class="hero-img" alt="Travel landscape" />
        <div class="hero-overlay"></div>

        <i class="fa-solid fa-plane-departure hero-icon-plane decor-icon"></i>

        <div class="hero-content">
            <div class="hero-badge">
                Tailor-made trips • Secure booking • 24/7 support
            </div>
            <h1 class="hero-title">Your next adventure starts here.</h1>
            <p class="hero-subtitle">
                Discover curated travel packages to the world’s most beautiful destinations.
            </p>

            <div class="hero-buttons d-flex">
                <a asp-controller="Package" asp-action="Gallery" class="btn btn-hero-primary">
                    Get Started
                </a>
            </div>
        </div>
    </section>

    <section class="home-section service-section">
        <h2 class="section-title">Our Service</h2>
        <p class="section-subtitle">Everything you need for a perfect trip – in one place.</p>
        <div class="service-card">
            <div class="row gy-4">
                <div class="col-md-6">
                    <div class="service-pill-title">Customized Travel Packages</div>
                    <p class="service-pill-text">Tailored itineraries for solo travelers, couples, families, or groups.</p>
                </div>
                <div class="col-md-6">
                    <div class="service-pill-title">Group & Corporate Travel</div>
                    <p class="service-pill-text">Special solutions for business trips and large organized groups.</p>
                </div>
                <div class="col-md-6">
                    <div class="service-pill-title">Flights & Hotels Booking</div>
                    <p class="service-pill-text">We book the best flights and hotels that match your budget.</p>
                </div>
                <div class="col-md-6">
                    <div class="service-pill-title">Adventure & Luxury Travel</div>
                    <p class="service-pill-text">From trekking expeditions to 5-star luxury resorts worldwide.</p>
                </div>
            </div>
        </div>
        <i class="fa-solid fa-person-walking-luggage service-icon-person decor-icon"></i>
    </section>

    <section class="home-section travel-types-section">
        <h2 class="section-title">Types of Travel We Offer</h2>
        <div class="types-wrapper">
            <div class="type-pill"><span class="type-name">FAMILY</span><span class="type-desc">Fun trips for all ages.</span></div>
            <div class="type-pill"><span class="type-name">ADVENTURE</span><span class="type-desc">Hiking, trekking, safaris.</span></div>
            <div class="type-pill"><span class="type-name">LUXURY</span><span class="type-desc">5-star resorts, private tours, VIP services.</span></div>
            <div class="type-pill"><span class="type-name">ROMANTIC</span><span class="type-desc">Perfect getaways for couples.</span></div>
            <div class="type-pill"><span class="type-name">NATURE</span><span class="type-desc">Mountains, lakes and national parks.</span></div>
            <div class="type-pill"><span class="type-name">CITY BREAK</span><span class="type-desc">Short stays in top cities.</span></div>
            <div class="type-pill"><span class="type-name">SKI</span><span class="type-desc">Winter resorts and ski holidays.</span></div>
            <div class="type-pill"><span class="type-name">BEACH RESORT</span><span class="type-desc">Sun, sea and full relaxation.</span></div>
        </div>
        <i class="fa-solid fa-map-location-dot types-icon-map decor-icon"></i>
    </section>

    <section class="home-section popular-section">
        <h2 class="section-title">Popular Destinations</h2>
        <p class="section-subtitle">A glimpse of the places our travelers love the most.</p>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="polaroid-card">
                    <img class="polaroid-img" src="https://images.unsplash.com/photo-1524231757912-21f4fe3a7200?auto=format&fit=crop&w=900&q=80" alt="Istanbul, Turkey" />
                    <div class="polaroid-caption">Istanbul, Turkey</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="polaroid-card">
                    <img class="polaroid-img" src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=900&q=80" alt="Athens, Greece" />
                    <div class="polaroid-caption">Athens, Greece</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="polaroid-card">
                    <img class="polaroid-img" src="https://images.unsplash.com/photo-1517154421773-0529f29ea451?auto=format&fit=crop&w=900&q=80" alt="Seoul, South Korea" />
                    <div class="polaroid-caption">Seoul, South Korea</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="polaroid-card">
                    <img class="polaroid-img" src="https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=900&q=80" alt="Paris, France" />
                    <div class="polaroid-caption">Paris, France</div>
                </div>
            </div>
        </div>
        <i class="fa-solid fa-camera-retro dest-icon-camera decor-icon"></i>
    </section>

    <section class="reviews-section home-section">
        <h2 class="section-title">What our clients say</h2>
        <div class="text-center mb-4">
            <div class="rating-number">4.5 ★</div>
            <p class="text-muted">Based on 1,248 reviews</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="review-card">
                    <div class="stars">★★★★★</div>
                    <p>"שירות מדהים! כל הטיול היה מתוקתק עד הפרט האחרון."</p>
                    <small class="text-muted">Amazing service, flawless planning.</small>
                    <strong class="d-block mt-1">יעל כהן</strong>
                </div>
            </div>
            <div class="col-md-4">
                <div class="review-card">
                    <div class="stars">★★★★☆</div>
                    <p>"חופשה מושלמת בפריז. צוות מקצועי ואכפתי."</p>
                    <small class="text-muted">Perfect Paris vacation, very professional team.</small>
                    <strong class="d-block mt-1">ניר אלקיים</strong>
                </div>
            </div>
            <div class="col-md-4">
                <div class="review-card">
                    <div class="stars">★★★★★</div>
                    <p>"זמינות מדהימה, מחיר הוגן וחוויית טיסה מעולה."</p>
                    <small class="text-muted">Great support, great value for money.</small>
                    <strong class="d-block mt-1">דנה רוזנברג</strong>
                </div>
            </div>
        </div>
        <i class="fa-solid fa-plane reviews-icon-plane decor-icon"></i>
    </section>

    <section class="quote-section">
        <div class="quote-main">The best journeys are not about where you go, but about the stories along the way.</div>
        <div class="quote-sub">Let us handle the planning – you just collect the memories.</div>
        <div class="quote-line"></div>
        <i class="fa-solid fa-person-walking-luggage quote-icon-person decor-icon"></i>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>