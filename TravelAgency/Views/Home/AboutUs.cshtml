@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800;900&display=swap" rel="stylesheet">

<style>
    body { background: #fdfdfd; font-family: 'Poppins', sans-serif; }

    /* ===== HERO SECTION ===== */
    .about-hero {
        position: relative;
        background: linear-gradient(rgba(11, 66, 85, 0.75), rgba(11, 66, 85, 0.75)),
        url('https://images.unsplash.com/photo-1488646953014-85cb44e25828?q=80&w=2000');
        background-size: cover;
        background-position: center;
        height: 480px;
        border-radius: 0 0 80px 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 80px;
        box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }


    .hero-tag {
        background: #FF9F1C;
        color: white;
        padding: 8px 24px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 20px;
        display: inline-block;
    }

    .about-title {
        font-size: 4.5rem;
        font-weight: 900;
        color: white;
        text-shadow: 2px 4px 20px rgba(0,0,0,0.4);
    }

    /* ===== STORY CARD ===== */
    .story-card {
        background: white;
        border-radius: 40px;
        padding: 60px;
        box-shadow: 0 30px 60px -12px rgba(0,0,0,0.12);
        border-top: 8px solid #FF9F1C;
        margin-top: -150px;
        position: relative;
        z-index: 5;
    }

    .section-header {
        font-size: 2.8rem;
        color: #0B4255;
        font-weight: 800;
        margin-bottom: 30px;
    }

    .about-text {
        font-size: 1.15rem;
        line-height: 1.9;
        color: #475569;
        text-align: justify;
        margin-bottom: 20px;
    }

    /* ===== VALUES BOXES ===== */
    .value-box {
        background: #ffffff;
        border-radius: 35px;
        padding: 40px 25px;
        border: 1px solid #edf2f7;
        transition: all 0.4s ease;
        text-align: center;
        height: 100%;
    }

    .value-box:hover {
        border-color: #13B8A6;
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(19, 184, 166, 0.1);
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        background: #E6F7F6;
        color: #13B8A6;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin: 0 auto 25px;
    }

    /* ===== TEAM SECTION ===== */
    .team-section {
        background: #0B4255;
        border-radius: 60px;
        padding: 80px 40px;
        margin: 80px 0;
        color: white;
        text-align: center;
    }

    .dev-avatar {
        width: 150px;
        height: 150px;
        background: #f8fafc;
        border-radius: 50%;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 5px solid #FF9F1C;
        overflow: hidden;
    }

    .dev-avatar img {
        width: 80%;
        height: auto;
    }

    .member-name {
        font-size: 1.4rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 5px;
    }

    .member-role {
        font-size: 0.9rem;
        color: #FF9F1C;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    @@media (max-width: 768px) {
        .about-title { font-size: 2.5rem; }
        .story-card { padding: 30px; margin-top: -100px; }
    }
</style>

<div class="container-fluid p-0">
    <div class="about-hero">
        <div class="text-center">
            <span class="hero-tag">Excellence in Tourism</span>
            <h1 class="about-title">About TravelAgency</h1>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="story-card text-center">
                <h2 class="section-header">Our Story</h2>
                <p class="about-text">
                    TravelAgency was established out of a true love for travel, experiences, and global exploration. 
                    We are a company that specializes in creating personalized travel itineraries in Israel and around the world. 
                    Our goal is to turn every vacation dream into a reality.
                </p>
                <p class="about-text">
                    With years of experience in the tourism industry, thousands of satisfied customers, and international partners, 
                    we provide a full service experience – from the planning stage until your safe return home.
                </p>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="value-box">
                <div class="icon-circle">🗺️</div>
                <h5 class="fw-bold mb-3">Worldwide Expertise</h5>
                <p class="text-muted small">We work with leading providers and know hundreds of destinations — from major cities to hidden corners.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="value-box">
                <div class="icon-circle">🧭</div>
                <h5 class="fw-bold mb-3">Personalized Trips</h5>
                <p class="text-muted small">We believe there is no single vacation that fits everyone — every itinerary is built to match the client.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="value-box">
                <div class="icon-circle">🎧</div>
                <h5 class="fw-bold mb-3">Premium Service</h5>
                <p class="text-muted small">Available for you 24/7, accompanying you from start to finish, handling every small detail.</p>
            </div>
        </div>
    </div>

    <div class="team-section">
        <h2 class="mb-5 display-6 fw-bold">MEET OUR TEAM</h2>
        
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="dev-avatar">
                    <img src="https://api.iconify.design/noto-v1:man-technologist-medium-light-skin-tone.svg" alt="Nadav">
                </div>
                <div class="member-name">Nadav Davidpur</div>
            </div>

            <div class="col-md-4">
                <div class="dev-avatar">
                    <img src="https://api.iconify.design/noto-v1:woman-technologist-light-skin-tone.svg" alt="Rinat">
                </div>
                <div class="member-name">Rinat Kabalik</div>
            </div>

            <div class="col-md-4">
                <div class="dev-avatar">
                    <img src="https://api.iconify.design/noto-v1:man-office-worker-light-skin-tone.svg" alt="Dan">
                </div>
                <div class="member-name">Dan Cohen</div>
            </div>
        </div>
    </div>
</div>