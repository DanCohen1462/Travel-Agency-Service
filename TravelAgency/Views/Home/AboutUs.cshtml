@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">About Our Travel Agency</h2>

    <p style="font-size: 1.1rem; line-height: 1.7;">
        Welcome to <strong>TravelAgency</strong> – your trusted partner for unforgettable journeys
        across Israel and around the world.  
        We specialize in crafting personalized travel experiences designed to match every dream,
        every budget, and every adventure style.
    </p>

    <p style="font-size: 1.1rem; line-height: 1.7;">
        Whether you're interested in exploring the breathtaking landscapes of Israel,
        enjoying luxury vacations abroad, or discovering hidden gems across the globe –  
        our expert team is here to guide you every step of the way.
    </p>

    <p style="font-size: 1.1rem; line-height: 1.7;">
        With years of experience, top-tier service, and a passion for travel,
        we make sure every trip becomes a memorable story.  
        Let us help you plan your next adventure with confidence, ease, and excitement.
    </p>

    <div class="text-center mt-4">
        <a class="btn btn-primary" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
    </div>
</div>
