@{
ViewData["Title"] = "Search Trip";
Layout = "_Layout";

string currentSearchText = ViewBag.SearchText as string ?? "";

string currentDestination = ViewBag.Destination as string ?? "";
string currentCountry = ViewBag.Country as string ?? "";
int? currentCategoryId = ViewBag.CategoryId as int?;

int adults = (int?)ViewBag.Adults ?? 1;
int children = (int?)ViewBag.Children ?? 0;
int? youngestAge = ViewBag.YoungestAge as int?;

int? month = ViewBag.Month as int?;
int? year = ViewBag.Year as int?;

string[] months = new[]
{
"January","February","March","April","May","June",
"July","August","September","October","November","December"
};

int nowYear = DateTime.Now.Year;
int selectedMonth = month ?? 0;
int selectedYear = year ?? 0;

// אם אין youngestAge – נשאיר ריק בתיבה (יותר נכון UX)
string youngestVal = youngestAge.HasValue ? youngestAge.Value.ToString() : "";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>

<style>
    body { background: #F5F7FA; }

    .page-title {
        font-size: 64px;
        font-weight: 900;
        color: #06334a;
        letter-spacing: -1px;
        margin: 18px 0 22px 0;
    }

    /* הגדלה משמעותית של המלבן */
    .search-shell {
        width: 100%;
        border-radius: 34px;
        padding: 34px;
        background: #ffffff;
        border: 3px solid rgba(19,184,166,0.55);
        box-shadow: 0 18px 45px rgba(0,0,0,0.10);
        overflow: visible;
    }

    /* כדי שכולם יהיו באותו קו: אין אלמנטים “נוספים” שמתחת לשדה Search */
    .search-grid {
        display: grid;
        grid-template-columns: 2.8fr 1.1fr 1.1fr 1.1fr 1.1fr 1.1fr 1.15fr;
        gap: 20px;
        align-items: end;
        width: 100%;
    }

    .field-label {
        font-weight: 800;
        color: #06334a;
        font-size: 22px;
        margin-bottom: 10px;
        min-height: 32px; /* מיישר גובה כותרות */
        display: flex;
        align-items: flex-end;
    }

    /* הגדלה של התיבות */
    .inp, .sel {
        height: 62px;
        border-radius: 18px;
        border: 1px solid #E6ECF5;
        box-shadow: none !important;
        font-size: 16px;
        padding-left: 16px;
        padding-right: 16px;
        width: 100%;
    }

    .inp:focus, .sel:focus {
        border-color: rgba(19,184,166,0.7);
        outline: none;
        box-shadow: 0 0 0 4px rgba(19,184,166,0.12) !important;
    }

    .btn-search {
        height: 62px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 20px;
        color: #fff;
        border: none;
        background: linear-gradient(90deg, #13B8A6, #0F6E8C);
        box-shadow: 0 10px 26px rgba(0,0,0,0.12);
        width: 100%;
    }

    .btn-search:hover { filter: brightness(0.97); }

    .search-field-wrap { position: relative; overflow: visible; width: 100%; }

    /* תיבת הצעות – גדולה וברורה */
    .suggest-box {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 8px);
        background: #fff;
        border: 1px solid #E6ECF5;
        border-radius: 14px;
        box-shadow: 0 18px 45px rgba(0,0,0,0.12);
        z-index: 9999;
        max-height: 320px;
        overflow-y: auto;
        display: none;
    }

    .suggest-item {
        padding: 12px 14px;
        cursor: pointer;
        font-size: 15px;
        color: #06334a;
        display: flex;
        justify-content: space-between;
        gap: 12px;
    }
    .suggest-item:hover { background: #F2FBFA; }

    .suggest-left { font-weight: 800; }
    .suggest-right { color: #6c757d; font-weight: 600; white-space: nowrap; }

    @@media (max-width: 1200px) {
        .page-title { font-size: 44px; }
        .search-grid { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 600px) {
        .search-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="container mt-4 mb-5">
    <div class="page-title">Find your next trip</div>

    @if (TempData["SearchError"] != null)
    {
    <div class="alert alert-danger">@TempData["SearchError"]</div>
    }

    <div class="search-shell">
        <form method="get" asp-controller="Package" asp-action="Gallery" id="searchStartForm">

            <input type="hidden" id="destination" name="destination" value="@currentDestination" />
            <input type="hidden" id="country" name="country" value="@currentCountry" />
            <input type="hidden" id="categoryId" name="categoryId" value="@(currentCategoryId.HasValue ? currentCategoryId.Value.ToString() : "")" />

            <div class="search-grid">

                <!-- SearchText -->
                <div class="search-field-wrap">
                    <div class="field-label">Search</div>
                    <input class="form-control inp"
                           id="searchText"
                           name="searchText"
                           value="@currentSearchText"
                           autocomplete="off"
                           placeholder="Type at least 2 letters (e.g., pa)" />

                    <div id="suggestions" class="suggest-box"></div>
                </div>

                <!-- Month -->
                <div>
                    <div class="field-label">Month</div>
                    <select class="form-select sel" id="month" name="month">
                        @if (selectedMonth == 0)
                        {
                        <option value="" selected>Any</option>
                        }
                        else
                        {
                        <option value="">Any</option>
                        }

                        @for (int i = 1; i <= 12; i++)
                        {
                        if (selectedMonth == i)
                        {
                        <option value="@i" selected>@months[i - 1]</option>
                        }
                        else
                        {
                        <option value="@i">@months[i - 1]</option>
                        }
                        }
                    </select>
                </div>

                <!-- Year -->
                <div>
                    <div class="field-label">Year</div>
                    <select class="form-select sel" id="year" name="year">
                        @if (selectedYear == 0)
                        {
                        <option value="" selected>Any</option>
                        }
                        else
                        {
                        <option value="">Any</option>
                        }

                        @for (int y = nowYear; y <= nowYear + 6; y++)
                        {
                        if (selectedYear == y)
                        {
                        <option value="@y" selected>@y</option>
                        }
                        else
                        {
                        <option value="@y">@y</option>
                        }
                        }
                    </select>
                </div>

                <!-- Adults -->
                <div>
                    <div class="field-label">Adults (18+)</div>
                    <input class="form-control inp"
                           type="number"
                           id="adults"
                           name="adults"
                           min="1"
                           value="@adults" />
                </div>

                <!-- Children -->
                <div>
                    <div class="field-label">Children (0–17)</div>
                    <input class="form-control inp"
                           type="number"
                           id="children"
                           name="children"
                           min="0"
                           value="@children" />
                </div>

                <!-- Youngest age -->
                <div>
                    <div class="field-label">Youngest age</div>
                    <input class="form-control inp"
                           type="number"
                           id="youngestAge"
                           name="youngestAge"
                           min="0"
                           max="17"
                           value="@youngestVal"
                           placeholder="Only if children"
                           disabled />
                </div>

                <!-- Button -->
                <div>
                    <button type="submit" class="btn-search" id="btnSearch">Search</button>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("searchStartForm");

        const searchInput = document.getElementById("searchText");
        const box = document.getElementById("suggestions");

        const destinationHidden = document.getElementById("destination");
        const countryHidden = document.getElementById("country");
        const categoryIdHidden = document.getElementById("categoryId");

        const childrenInput = document.getElementById("children");
        const youngestInput = document.getElementById("youngestAge");

        function hideBox() {
            box.style.display = "none";
            box.innerHTML = "";
        }

        function clearChosenSuggestion() {
            destinationHidden.value = "";
            countryHidden.value = "";
            categoryIdHidden.value = "";
        }

        // ✅ חובה youngestAge רק אם יש ילדים
        function syncYoungestState() {
            const c = parseInt(childrenInput.value || "0");
            if (c > 0) {
                youngestInput.disabled = false;
                youngestInput.required = true;
            } else {
                youngestInput.required = false;
                youngestInput.disabled = true;
                youngestInput.value = "";
            }
        }
        syncYoungestState();
        childrenInput.addEventListener("input", syncYoungestState);

        let controller = new AbortController();
        let lastQ = "";

        function render(items) {
            if (!items || items.length === 0) {
                hideBox();
                return;
            }

            box.innerHTML = "";
            items.forEach(it => {
                const row = document.createElement("div");
                row.className = "suggest-item";

                row.dataset.displayText = it.displayText || "";
                row.dataset.destination = it.destination || "";
                row.dataset.country = it.country || "";
                row.dataset.categoryId = (it.categoryId === null || it.categoryId === undefined) ? "" : it.categoryId;

                const left = document.createElement("div");
                left.className = "suggest-left";
                left.textContent = it.displayText || "";

                const right = document.createElement("div");
                right.className = "suggest-right";
                right.textContent = "";

                row.appendChild(left);
                row.appendChild(right);

                row.addEventListener("click", () => {
                    searchInput.value = row.dataset.displayText;

                    destinationHidden.value = row.dataset.destination;
                    countryHidden.value = row.dataset.country;
                    categoryIdHidden.value = row.dataset.categoryId;

                    hideBox();
                });

                box.appendChild(row);
            });

            box.style.display = "block";
        }

        async function loadSuggestions(q) {
            try {
                controller.abort();
                controller = new AbortController();

                const url = `/Package/Suggest?q=${encodeURIComponent(q)}`;
                const res = await fetch(url, { signal: controller.signal });
                if (!res.ok) { hideBox(); return; }

                const data = await res.json();
                render(data);
            } catch (e) {
                // abort is ok
            }
        }

        searchInput.addEventListener("input", () => {
            const q = (searchInput.value || "").trim();

            clearChosenSuggestion();

            if (q.length < 2) { hideBox(); return; }
            if (q === lastQ) return;
            lastQ = q;

            loadSuggestions(q);
        });

        document.addEventListener("click", (e) => {
            if (!box.contains(e.target) && e.target !== searchInput) hideBox();
        });

        // ✅ בדיקת submit (גם אם הדפדפן לא אוכף required משום מה)
        form.addEventListener("submit", (e) => {
            const c = parseInt(childrenInput.value || "0");

            if (c > 0) {
                const yStr = (youngestInput.value || "").trim();
                const y = parseInt(yStr);

                if (yStr === "" || isNaN(y) || y < 0 || y > 17) {
                    e.preventDefault();
                    alert("Please enter the youngest child age (0–17).");
                    youngestInput.focus();
                }
            }
        });
    });
</script>
}
