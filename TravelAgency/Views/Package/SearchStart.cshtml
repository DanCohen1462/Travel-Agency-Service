@{
ViewData["Title"] = "Search Trip";
Layout = "_Layout";

string currentSearchText = ViewBag.SearchText as string ?? "";

string currentDestination = ViewBag.Destination as string ?? "";
string currentCountry = ViewBag.Country as string ?? "";
int? currentCategoryId = ViewBag.CategoryId as int?;

int adults = (int?)ViewBag.Adults ?? 1;
int children = (int?)ViewBag.Children ?? 0;
int? youngestAge = ViewBag.YoungestAge as int?;

int? month = ViewBag.Month as int?;
int? year = ViewBag.Year as int?;

string[] months = new[]
{
"January","February","March","April","May","June",
"July","August","September","October","November","December"
};

int nowYear = DateTime.Now.Year;
int selectedMonth = month ?? 0;
int selectedYear = year ?? 0;

// אם אין youngestAge – נשאיר ריק בתיבה (יותר נכון UX)
string youngestVal = youngestAge.HasValue ? youngestAge.Value.ToString() : "";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>

<style>
    body { background: #f0f4f8; }

    .page-title {
        font-size: 48px;
        font-weight: 800;
        color: #06334a;
        margin: 30px 0 10px 0;
        text-align: center;
    }
    
    .page-subtitle {
        text-align: center;
        color: #64748b;
        margin-bottom: 40px;
        font-size: 18px;
    }

    .search-shell {
        width: 100%;
        border-radius: 24px;
        padding: 40px;
        background: #ffffff;
        /* צללית רכה ויוקרתית במקום מסגרת עבה */
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        position: relative;
    }

    /* פס צבע דקורטיבי עליון */
    .search-shell::before {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 6px;
        background: linear-gradient(90deg, #13B8A6, #0F6E8C);
        border-radius: 24px 24px 0 0;
    }

    .search-grid {
        display: grid;
        grid-template-columns: 2.2fr 1fr 1fr 0.8fr 0.8fr 0.8fr 1.2fr;
        gap: 15px;
        align-items: end;
    }

    .field-label {
        font-weight: 700;
        color: #475569;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .field-label i {
        color: #13B8A6;
        font-size: 14px;
    }

    .inp, .sel {
        height: 56px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        background-color: #f8fafc;
        font-weight: 500;
        color: #1e293b;
        transition: all 0.2s ease;
    }

    .inp:focus, .sel:focus {
        background-color: #fff;
        border-color: #13B8A6;
        box-shadow: 0 0 0 4px rgba(19, 184, 166, 0.1) !important;
    }

    .btn-search {
        height: 56px;
        border-radius: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        background: #06334a;
        transition: all 0.3s ease;
        border: none;
    }

    .btn-search:hover {
        background: #13B8A6;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(19, 184, 166, 0.2);
    }

    /* עיצוב youngest age כשהוא כבוי */
    .inp:disabled {
        background-color: #f1f5f9;
        opacity: 0.6;
        border-style: dashed;
    }

    /* תיבת הצעות משודרגת */
    .suggest-box {
        border-radius: 12px;
        border: none;
        box-shadow: 0 15px 30px rgba(0,0,0,0.15);
        margin-top: 10px;
    }

    /* ===== Suggestions dropdown ===== */
    .search-field-wrap {
        position: relative;
    }

    .suggest-box {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        background: #ffffff;
        z-index: 9999;
        display: none;
        max-height: 280px;
        overflow-y: auto;
    }

    /* פריט הצעה */
    .suggest-item {
        padding: 14px 16px;
        cursor: pointer;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
        color: #1e293b;
        transition: background 0.2s ease;
    }

    .suggest-item:hover {
        background: #f0fdfa;
        color: #0f766e;
    }


    @@media (max-width: 1200px) {
        .search-grid { grid-template-columns: 1fr 1fr 1fr; }
    }
    @@media (max-width: 768px) {
        .search-grid { grid-template-columns: 1fr; }
        .search-shell { padding: 25px; }
    }
</style>

<div class="container mt-5 mb-5">
    <h1 class="page-title">Find your next trip</h1>
    <p class="page-subtitle">Where your travel dreams meet expert planning</p>

    <div class="search-shell">
        <form method="get" asp-controller="Package" asp-action="Gallery" id="searchStartForm">
            <input type="hidden" id="destination" name="destination" value="@currentDestination" />
            <input type="hidden" id="country" name="country" value="@currentCountry" />
            <input type="hidden" id="categoryId" name="categoryId" value="@(currentCategoryId.HasValue ? currentCategoryId.Value.ToString() : "")" />

            <div class="search-grid">

                <div class="search-field-wrap">
                    <label class="field-label"><i class="fa-solid fa-magnifying-glass"></i> Where to?</label>
                    <input class="form-control inp" id="searchText" name="searchText" value="@currentSearchText" autocomplete="off" placeholder="Destination or theme..." />
                    <div id="suggestions" class="suggest-box"></div>
                </div>

                <div>
                    <label class="field-label"><i class="fa-solid fa-calendar-days"></i> Month</label>
                    <select class="form-select sel" id="month" name="month">
                        <option value="">Any Month</option>
                        @for (int i = 1; i <= 12; i++) {
                            <option value="@i" selected="@(selectedMonth == i)">@months[i - 1]</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="field-label"><i class="fa-solid fa-calendar"></i> Year</label>
                    <select class="form-select sel" id="year" name="year">
                        <option value="">Any Year</option>
                        @for (int y = nowYear; y <= nowYear + 6; y++) {
                            <option value="@y" selected="@(selectedYear == y)">@y</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="field-label"><i class="fa-solid fa-user"></i> Adults</label>
                    <input class="form-control inp text-center" type="number" id="adults" name="adults" min="1" value="@adults" />
                </div>

                <div>
                    <label class="field-label"><i class="fa-solid fa-child"></i> Kids</label>
                    <input class="form-control inp text-center" type="number" id="children" name="children" min="0" value="@children" />
                </div>

                <div>
                    <label class="field-label"><i class="fa-solid fa-baby"></i> Youngest</label>
                    <input class="form-control inp text-center" type="number" id="youngestAge" name="youngestAge" min="0" max="17" value="@youngestVal" placeholder="Age" disabled />
                </div>

                <div>
                    <button type="submit" class="btn btn-search w-100 text-white">
                        <i class="fa-solid fa-plane-departure me-2"></i> Search
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("searchStartForm");

        const searchInput = document.getElementById("searchText");
        const box = document.getElementById("suggestions");

        const destinationHidden = document.getElementById("destination");
        const countryHidden = document.getElementById("country");
        const categoryIdHidden = document.getElementById("categoryId");

        const childrenInput = document.getElementById("children");
        const youngestInput = document.getElementById("youngestAge");

        if (!destinationHidden || !countryHidden || !categoryIdHidden) return;

        function hideBox() {
            box.style.display = "none";
            box.innerHTML = "";
        }

        function clearChosenSuggestion() {
            destinationHidden.value = "";
            countryHidden.value = "";
            categoryIdHidden.value = "";
        }

        // ✅ חובה youngestAge רק אם יש ילדים
        function syncYoungestState() {
            const c = parseInt(childrenInput.value || "0");
            if (c > 0) {
                youngestInput.disabled = false;
                youngestInput.required = true;
            } else {
                youngestInput.required = false;
                youngestInput.disabled = true;
                youngestInput.value = "";
            }
        }
        syncYoungestState();
        childrenInput.addEventListener("input", syncYoungestState);

        let controller = new AbortController();
        let lastQ = "";

        function render(items) {
            if (!items || items.length === 0) {
                hideBox();
                return;
            }

            box.innerHTML = "";
            items.forEach(it => {
                const row = document.createElement("div");
                row.className = "suggest-item";

                row.dataset.displayText = it.displayText || "";
                row.dataset.destination = it.destination || "";
                row.dataset.country = it.country || "";
                row.dataset.categoryId = (it.categoryId === null || it.categoryId === undefined) ? "" : it.categoryId;

                const left = document.createElement("div");
                left.className = "suggest-left";
                left.textContent = it.displayText || "";

                const right = document.createElement("div");
                right.className = "suggest-right";
                right.textContent = "";

                row.appendChild(left);
                row.appendChild(right);

                row.addEventListener("click", () => {
                    searchInput.value = row.dataset.displayText;

                    destinationHidden.value = row.dataset.destination;
                    countryHidden.value = row.dataset.country;
                    categoryIdHidden.value = row.dataset.categoryId;

                    hideBox();
                });

                box.appendChild(row);
            });

            box.style.display = "block";
        }

        async function loadSuggestions(q) {
            try {
                controller.abort();
                controller = new AbortController();

                const suggestUrl = '@Url.Action("Suggest","Package")';
                const url = `${suggestUrl}?q=${encodeURIComponent(q)}`;

                const res = await fetch(url, { signal: controller.signal });
                if (!res.ok) { hideBox(); return; }

                const data = await res.json();
                render(data);
            } catch (e) {
                // abort is ok
            }
        }

        searchInput.addEventListener("input", () => {
            const q = (searchInput.value || "").trim();

            clearChosenSuggestion();

            if (q.length < 2) { hideBox(); return; }
            if (q === lastQ) return;
            lastQ = q;

            loadSuggestions(q);
        });

        document.addEventListener("click", (e) => {
            if (!box.contains(e.target) && e.target !== searchInput) hideBox();
        });

        // ✅ בדיקת submit (גם אם הדפדפן לא אוכף required משום מה)
        form.addEventListener("submit", (e) => {
            const c = parseInt(childrenInput.value || "0");

            if (c > 0) {
                const yStr = (youngestInput.value || "").trim();
                const y = parseInt(yStr);

                if (yStr === "" || isNaN(y) || y < 0 || y > 17) {
                    e.preventDefault();
                    alert("Please enter the youngest child age (0–17).");
                    youngestInput.focus();
                }
            }
        });
    });
</script>
}
