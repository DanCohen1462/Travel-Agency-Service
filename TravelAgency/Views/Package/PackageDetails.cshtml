
@{
ViewBag.Title = "Package Details";
Layout = "_Layout";

var id = ViewBag.Id; // מזהה חבילה
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #F6F7FB;
    }

    .header-img {
        width: 100%;
        height: 380px;
        object-fit: cover;
        border-radius: 20px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        margin-bottom: 30px;
    }

    .info-box {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

    .details-title {
        font-size: 32px;
        font-weight: 700;
    }

    .details-label {
        font-weight: 600;
        color: #1C6DD0;
    }

    .btn-book {
        background: #1C6DD0;
        color: white;
        width: 100%;
        border-radius: 12px;
        padding: 12px;
        font-size: 20px;
        font-weight: 600;
        border: none;
        transition: 0.2s;
    }

    .btn-book:hover {
        background: #155BB4;
    }

    .tag {
        background: #EEF1F6;
        padding: 6px 12px;
        border-radius: 12px;
        margin-right: 6px;
        display: inline-block;
        font-size: 14px;
    }

    .description-box {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }
    
     .btn-book {
         background: #1C6DD0;
         color: white;
         width: 100%;
         border-radius: 12px;
         padding: 12px;
         font-size: 20px;
         font-weight: 600;
         border: none;
         transition: 0.2s;
     }
    .btn-book:hover {
        background: #155BB4;
    }

    .btn-buy {
        background: #28A745;
        color: white;
        width: 100%;
        border-radius: 12px;
        padding: 12px;
        font-size: 20px;
        font-weight: 600;
        border: none;
        transition: 0.2s;
    }
    .btn-buy:hover {
        background: #1E7E34;
    }
</style>

<div class="container mt-5 mb-5">

    <!-- IMAGE -->
    <img src="/images/@(id == 101 ? "paris.jpg" : id == 202 ? "Roma.jpeg" : "london.jpg")"
         class="header-img" />
    <!-- TITLE -->
    <h2 class="details-title">
        Package #@id —
        @(id == 101 ? "Paris"
        : id == 202 ? "Rome"
        : "London")
    </h2>

    <div class="row mt-4">

        <!-- LEFT SIDE -->
        <div class="col-md-8">

            <!-- DESCRIPTION -->
            <div class="description-box">
                <h4 class="mb-3">About this trip</h4>
                <p style="font-size: 17px; line-height: 1.6;">
                    @(id == 101 ?
                        "A romantic getaway in Paris — the city of love. Perfect for couples who want a magical experience with food, art, and unforgettable nights."
                        :
                        id == 202 ?
                            "Experience the ancient beauty of Rome — museums, culture, guided tours, and authentic Italian taste like nowhere else."
                            :
                            "Explore London — modern attractions, historical sites, musicals, and the perfect family vacation.")
                </p>

                <span class="tag">16+ Age Limit</span>
                <span class="tag">@(id == 101 ? "Honeymoon" : id == 202 ? "Adventure" : "Family")</span>
                <span class="tag">@((id == 101 ? 5 : id == 202 ? 3 : 7)) Rooms Left</span>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="col-md-4">

            <div class="info-box">
                <p class="details-label">Start Date:</p>
                <p>@(id == 101 ? "12/03/2025" : id == 202 ? "01/04/2025" : "20/04/2025")</p>

                <p class="details-label">End Date:</p>
                <p>@(id == 101 ? "17/03/2025" : id == 202 ? "05/04/2025" : "26/04/2025")</p>

                <p class="details-label">Price:</p>
                <p style="font-size: 26px; font-weight: 700;">
                    @(id == 101 ? "$899" : id == 202 ? "$750" : "$1150")
                </p>

                <div class="d-flex gap-3 mt-3">
                    <a class="btn-book flex-fill text-center text-decoration-none"
                       asp-controller="Home" asp-action="Cart" asp-route-id="@id">
                        Book Now
                    </a>     
                    <a asp-controller="Home" asp-action="Payment" class="btn-buy flex-fill text-center">
                        Buy Now
                    </a>              
                    </div>
            </div>

        </div>
    </div>
    <a asp-controller="Package" asp-action="Gallery" class="btn-back">
        ← Back to Packages
    </a>

    <style>
    .btn-back {
        display: inline-block;
        margin-bottom: 20px;
        background: #e9ecf2;
        color: #1C6DD0;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 17px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-back:hover {
        background: #d7dbe3;
        color: #124f9e;
    }
</style>

</div>