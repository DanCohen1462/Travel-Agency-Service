@model TravelAgency.Models.PackageDetailsViewModel

@{
    Layout = "_Layout";
    var pkg = Model.Package;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #F6F7FB;
    }

    .header-img {
        width: 100%;
        height: 380px;
        object-fit: cover;
        border-radius: 20px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        margin-bottom: 30px;
    }

    .info-box {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

    .details-title {
        font-size: 32px;
        font-weight: 700;
    }

    .details-label {
        font-weight: 600;
        color: #1C6DD0;
    }

    .tag {
        background: #EEF1F6;
        padding: 6px 12px;
        border-radius: 12px;
        margin-right: 6px;
        display: inline-block;
        font-size: 14px;
    }

    .description-box {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    /* ===== כפתורים ===== */
    .btn-row {
        display: flex;
        gap: 10px;
        margin-top: 12px;
    }

    .btn-book,
    .btn-buy {
        flex: 1;
        border-radius: 12px;
        padding: 10px;
        font-size: 16px;
        font-weight: 600;
        border: none;
        transition: 0.2s;
        white-space: nowrap;   /* שלא ישברו לשתי שורות */
        text-align: center;
    }

    .btn-book {
        background: #1C6DD0;
        color: white;
    }

    .btn-book:hover {
        background: #155BB4;
    }

    .btn-buy {
        background: #28A745;
        color: white;
    }

    .btn-buy:hover {
        background: #1E7E34;
    }

    .badge-leftover {
        display: inline-block;
        background: rgba(220, 53, 69, 0.9);
        color: #fff;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-left: 8px;
    }

    .btn-back {
        display: inline-block;
        margin-top: 15px;
        background: #e9ecf2;
        color: #1C6DD0;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 17px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-back:hover {
        background: #d7dbe3;
        color: #124f9e;
    }
</style>

<div class="container mt-5 mb-5">

    <!-- תמונת כותרת -->
    <img src="@pkg.image" class="header-img" alt="@pkg.destination" />

    <!-- כותרת + קטגוריה + מצב מקומות -->
    <h2 class="details-title">
        @pkg.destination

        @if (!string.IsNullOrEmpty(Model.CategoryName))
        {
            <span class="tag">@Model.CategoryName</span>
        }

        @if (Model.IsAlmostFull)
        {
            <span class="badge-leftover">
                נשארו רק @pkg.numFreePlaces מקומות
            </span>
        }
        else if (Model.IsFull)
        {
            <span class="badge-leftover">
                הטיול מלא
            </span>
        }
    </h2>

    <div class="row mt-4">

        <!-- LEFT: תיאור -->
        <div class="col-md-8">
            <div class="description-box">
                <h4 class="mb-3">About this trip</h4>
                <p style="font-size: 17px; line-height: 1.6;">
                    @pkg.information
                </p>

                <span class="tag">Age limit: @pkg.ageLimit+</span>
                <span class="tag">
                    Dates: @pkg.StartDate.ToString("dd/MM/yyyy")
                    -
                    @pkg.EndDate.ToString("dd/MM/yyyy")
                </span>
                <span class="tag">
                    Rooms left:
                    @(Model.IsFull ? "Full" : pkg.numFreePlaces.ToString())
                </span>
            </div>
        </div>

        <!-- RIGHT: סיכום + כפתורים -->
        <div class="col-md-4">
            <div class="info-box">
                <p class="details-label">Destination:</p>
                <p>@pkg.destination</p>

                <p class="details-label">Start Date:</p>
                <p>@pkg.StartDate.ToString("dd/MM/yyyy")</p>

                <p class="details-label">End Date:</p>
                <p>@pkg.EndDate.ToString("dd/MM/yyyy")</p>

                <p class="details-label">Price:</p>
                <p style="font-size: 26px; font-weight: 700;">
                    $@pkg.sum
                </p>

                @if (Model.IsFull)
                {
                    <!-- טיול מלא – רק רשימת המתנה -->
                    <form method="post"
                          asp-controller="Booking"
                          asp-action="JoinWaitlist"
                          class="mt-3">
                        <input type="hidden" name="packageId" value="@pkg.Id" />
                        <button type="submit"
                                class="btn btn-outline-secondary w-100"
                                onclick="return confirm('להצטרף לרשימת ההמתנה לטיול הזה?');">
                            Join Waitlist
                        </button>
                    </form>
                }
                else
                {
                    <!-- טיול לא מלא – שני כפתורים זה לצד זה -->
                    <div class="btn-row">
                        <form method="post"
                              asp-controller="Cart"
                              asp-action="Add"
                              class="m-0 flex-fill">
                            <input type="hidden" name="packageId" value="@pkg.Id" />
                            <button type="submit" class="btn-book">
                                Add to Cart
                            </button>
                        </form>

                        <a asp-controller="Home"
                           asp-action="Payment"
                           class="btn-buy text-decoration-none">
                            Go to Payment
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <a asp-controller="Package" asp-action="Gallery" class="btn-back">
        ← Back to Packages
    </a>
</div>
