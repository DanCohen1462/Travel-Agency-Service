@{
ViewBag.Title = "Travel Packages";
Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #F6F7FB;
    }

    .package-card {
        background: #fff;
        border-radius: 18px;
        padding: 0;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: 0.3s;
    }

    .package-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 14px 40px rgba(0,0,0,0.12);
    }

    .package-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .package-body {
        padding: 20px;
    }

    .badge-category {
        padding: 6px 12px;
        font-size: 14px;
        border-radius: 10px;
        font-weight: 600;
    }

    .tag {
        background: #EDF0F5;
        padding: 5px 10px;
        border-radius: 12px;
        font-size: 14px;
        margin-right: 5px;
        display: inline-block;
    }

    .price {
        font-size: 24px;
        font-weight: 700;
        color: #1C6DD0;
    }

    .btn-details {
        width: 100%;
        margin-top: 10px;
        border-radius: 10px;
        padding: 10px;
        font-size: 17px;
        font-weight: 600;
        background: #1C6DD0;
        color: white;
        border: none;
        text-align: center;
        display: block;
        text-decoration: none;
    }

    .btn-details:hover {
        background: #155BB4;
        color: white;
    }
</style>

<div class="container mt-5 mb-5">
    <h2 class="mb-4 fw-bold">Available Travel Packages</h2>

    @if (!string.IsNullOrEmpty(Context.Request.Query["destination"]))
    {
    <p class="text-muted mb-4">
        Showing results for:
        <strong>@Context.Request.Query["destination"]</strong>
    </p>
    }

    <div class="row g-4">

        <!-- ====================== PACKAGE 1 ====================== -->
        <div class="col-md-4">
            <div class="package-card">
                <img src="/images/paris.jpg" class="package-img" alt="Paris">

                <div class="package-body">
                    <span class="badge bg-primary badge-category">Honeymoon</span>

                    <h4 class="mt-3">Package #101 — Paris</h4>
                    <p class="tag">Start: 12/03/2025</p>
                    <p class="tag">End: 17/03/2025</p>

                    <p><strong>Age Limit:</strong> 16+</p>
                    <p><strong>Rooms Left:</strong> 5</p>

                    <p class="price">$899</p>

                    <a href="/Package/PackageDetails/101" class="btn-details">
                        View Details
                    </a>
                </div>
            </div>
        </div>

        <!-- ====================== PACKAGE 2 ====================== -->
        <div class="col-md-4">
            <div class="package-card">
                <img src="/images/rome.jpg" class="package-img" alt="Roma">

                <div class="package-body">
                    <span class="badge bg-warning text-dark badge-category">Adventure</span>

                    <h4 class="mt-3">Package #202 — Roma</h4>
                    <p class="tag">Start: 01/04/2025</p>
                    <p class="tag">End: 05/04/2025</p>

                    <p><strong>Age Limit:</strong> 16+</p>
                    <p><strong>Rooms Left:</strong> 3</p>

                    <p class="price">$750</p>

                    <a href="/Package/PackageDetails/202" class="btn-details">
                        View Details
                    </a>
                </div>
            </div>
        </div>

        <!-- ====================== PACKAGE 3 ====================== -->
        <div class="col-md-4">
            <div class="package-card">
                <img src="/images/london.jpg" class="package-img" alt="London">

                <div class="package-body">
                    <span class="badge bg-success badge-category">Family</span>

                    <h4 class="mt-3">Package #303 — London</h4>
                    <p class="tag">Start: 20/04/2025</p>
                    <p class="tag">End: 26/04/2025</p>

                    <p><strong>Age Limit:</strong> 16+</p>
                    <p><strong>Rooms Left:</strong> 7</p>

                    <p class="price">$1150</p>

                    <a href="/Package/PackageDetails/303" class="btn-details">
                        View Details
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>