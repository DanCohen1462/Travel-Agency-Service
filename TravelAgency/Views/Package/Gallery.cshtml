@using TravelAgency.Models
@model List<TravelAgency.Models.Package>

@{
    ViewBag.Title = "Travel Packages";
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #F6F7FB;
    }

    .package-card {
        background: #fff;
        border-radius: 18px;
        padding: 0;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: 0.3s;
        position: relative;          /* חשוב לעיגול האדום */
    }

    .package-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 14px 40px rgba(0,0,0,0.12);
    }

    /* כרטיס של טיול מלא (אין מקומות) */
    .package-card-full {
        filter: grayscale(0.7);
        opacity: 0.75;
    }

    .package-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .package-body {
        padding: 20px;
    }

    .badge-category {
        padding: 6px 12px;
        font-size: 14px;
        border-radius: 10px;
        font-weight: 600;
    }

    .category-badge {
        background: #FFE08A;
        color: #333;
        padding: 6px 14px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        display: inline-block;
        margin-bottom: 10px;
    }

    .tag {
        background: #EDF0F5;
        padding: 5px 10px;
        border-radius: 12px;
        font-size: 14px;
        margin-right: 5px;
        display: inline-block;
    }

    .price {
        font-size: 24px;
        font-weight: 700;
        color: #1C6DD0;
    }

    .btn-details {
        width: 100%;
        margin-top: 10px;
        border-radius: 10px;
        padding: 10px;
        font-size: 17px;
        font-weight: 600;
        background: #1C6DD0;
        color: white;
        border: none;
        text-align: center;
        display: block;
        text-decoration: none;
    }

    .btn-details:hover {
        background: #155BB4;
        color: white;
    }

    /* עיגול אדום – נשארו מעט מקומות */
    .badge-leftover {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(220, 53, 69, 0.88); /* אדום שקוף */
        color: #fff;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 0.85rem;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .filter-bar {
        position: relative;
    }

    .search-suggestions {
        position: absolute;
        right: 0;
        top: 100%;
        margin-top: 4px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        max-height: 220px;
        overflow-y: auto;
        z-index: 1000;
        width: 220px;
    }

    .search-suggestions-item {
        padding: 6px 10px;
        cursor: pointer;
        font-size: 14px;
    }

    .search-suggestions-item:hover {
        background: #F2F4F8;
    }

</style>

<div class="container mt-5 mb-5">
    <h2 class="mb-4 fw-bold">Available Travel Packages</h2>

    @if (!string.IsNullOrEmpty(Context.Request.Query["destination"]))
    {
        <p class="text-muted mb-4">
            Showing results for:
            <strong>@Context.Request.Query["destination"]</strong>
        </p>
    }

    <!-- ==================== FILTER BAR ==================== -->
    <div class="filter-bar d-flex align-items-center gap-3 mb-4">

        <!-- Destination Filter -->
        <select id="filterDestination" class="form-select" style="max-width: 180px;">
            <option value="">Destination</option>
            @foreach (var dest in ViewBag.Destinations)
            {
                <option value="@dest">@dest</option>
            }
        </select>

        <!-- Category Filter -->
        <select id="filterCategory" class="form-select" style="max-width: 180px;">
            <option value="">Category</option>
            @foreach (var cat in ViewBag.Categories)
            {
                <option value="@cat.Id">@cat.name</option>
            }
        </select>

        <!-- Price Filter -->
        <select id="filterPrice" class="form-select" style="max-width: 160px;">
            <option value="">Price</option>
            <option value="1">Under $500</option>
            <option value="2">$500 - $1000</option>
            <option value="3">Above $1000</option>
        </select>

        <!-- Min Free Spots Filter -->
        <select id="filterSpots" class="form-select" style="max-width: 170px;">
            <option value="">Min Spots</option>
            <option value="1">1+</option>
            <option value="5">5+</option>
            <option value="10">10+</option>
        </select>

        <!-- Free Search + suggestions -->
        <div style="position: relative;">
            <input id="filterSearch" type="text" class="form-control"
                   placeholder="Search trips..." style="max-width: 220px;"/>

            <div id="searchSuggestions" class="search-suggestions"></div>
        </div>

        <button id="btnSearch" class="btn btn-primary" style="height: 38px;">
            Search
        </button>
    </div>
    <!-- ===================================================== -->

    <div class="row g-4">

        @foreach (var pkg in Model)
        {
            var cats = ViewBag.Categories as List<Category>;
            var cat = cats?.FirstOrDefault(c => c.Id == pkg.idCategory);

            bool isFull = pkg.numFreePlaces <= 0;
            bool isAlmostFull = pkg.numFreePlaces > 0 && pkg.numFreePlaces <= 5;



            <div class="col-md-4 package-item"
                 data-destination="@pkg.destination"
                 data-category="@(cat != null ? cat.Id.ToString() : "")"
                 data-categoryname="@(cat != null ? cat.name : "")"
                 data-spots="@pkg.numFreePlaces"
                 data-price="@pkg.sum"
                 data-text="@(pkg.destination + " " + (cat != null ? cat.name + " " : "") + pkg.information)">

                <div class="package-card @(isFull ? "package-card-full" : "")">
                    <img src="@pkg.image" class="package-img" alt="@pkg.destination" />

                    <div class="package-body">

                        @* עיגול אדום – מעט מקומות *@
                        @if (isAlmostFull)
                        {
                            <div class="badge-leftover">
                                נשארו רק @pkg.numFreePlaces מקומות פנויים
                            </div>
                        }

                        @* מציגים קטגוריה רק אם יש *@
                        @if (cat != null)
                        {
                            <span class="category-badge">@cat.name</span>
                        }

                        <h4 class="mt-3">
                            Package #@pkg.Id — @pkg.destination
                        </h4>

                        <p class="tag">
                            Start: @pkg.StartDate.ToString("dd/MM/yyyy")
                        </p>
                        <p class="tag">
                            End: @pkg.EndDate.ToString("dd/MM/yyyy")
                        </p>

                        <p>
                            <strong>Age Limit:</strong> @pkg.ageLimit+
                        </p>

                        <p>
                            <strong>Rooms Left:</strong>
                            @if (isFull)
                            {
                                <span class="text-danger fw-semibold">Full</span>
                            }
                            else
                            {
                                @pkg.numFreePlaces
                            }
                        </p>

                        <p class="price">$@pkg.sum</p>

                        @* אם הטיול מלא – כפתור רשימת המתנה *@
                        @if (isFull)
                        {
                            <form method="post"
                                  asp-controller="Booking"
                                  asp-action="JoinWaitlist"
                                  class="mt-2">
                                <input type="hidden" name="packageId" value="@pkg.Id" />
                                <button type="submit"
                                        class="btn btn-outline-secondary w-100"
                                        onclick="return confirm('את/ה בטוח/ה שברצונך להצטרף לרשימת ההמתנה לטיול זה?');">
                                    הצטרף לרשימת המתנה
                                </button>
                            </form>

                            <a href="/Package/PackageDetails/@pkg.Id"
                               class="btn btn-details mt-2"
                               style="background:#6c757d;">
                                View Details
                            </a>
                        }
                        else
                        {
                            <a href="/Package/PackageDetails/@pkg.Id" class="btn-details">
                                View Details
                            </a>

                            @* כפתור הוספה לעגלה – הלוגיקה ב-Controller נעשה בשלב הבא *@
                            <form method="post"
                                  asp-controller="Cart"
                                  asp-action="Add"
                                  class="mt-2">
                                <input type="hidden" name="packageId" value="@pkg.Id" />
                                <button type="submit" class="btn btn-success w-100">
                                    Add to Cart
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btnSearch = document.getElementById("btnSearch");
            const selDestination = document.getElementById("filterDestination");
            const selCategory = document.getElementById("filterCategory");
            const selPrice = document.getElementById("filterPrice");
            const selSpots = document.getElementById("filterSpots");
            const txtSearch = document.getElementById("filterSearch");
            const suggestionBox = document.getElementById("searchSuggestions");

            const cards = document.querySelectorAll(".package-item");

            function normalize(str) {
                return (str || "")
                    .toLowerCase()
                    .replace(/,/g, " ")
                    .replace(/\s+/g, " ")
                    .trim();
            }

            function applyFilter() {
                const dest = normalize(selDestination.value);
                const cat = (selCategory.value || "").trim();
                const priceFilter = selPrice.value;
                const minSpots = selSpots.value ? parseInt(selSpots.value) : 0;
                const text = normalize(txtSearch.value);

                cards.forEach(card => {
                    const cardDest = normalize(card.dataset.destination || "");
                    const cardCat = (card.dataset.category || "");
                    const cardSpots = parseInt(card.dataset.spots || "0");
                    const cardPrice = parseInt(card.dataset.price || "0");
                    const cardText = normalize(card.dataset.text || "");

                    let show = true;

                    if (dest && !cardDest.includes(dest)) {
                        show = false;
                    }

                    if (show && cat && cardCat !== cat) {
                        show = false;
                    }

                    if (show && priceFilter) {
                        if (priceFilter === "1" && cardPrice >= 500) show = false;
                        if (priceFilter === "2" && (cardPrice < 500 || cardPrice > 1000)) show = false;
                        if (priceFilter === "3" && cardPrice <= 1000) show = false;
                    }

                    if (show && minSpots && (isNaN(cardSpots) || cardSpots < minSpots)) {
                        show = false;
                    }

                    if (show && text && !cardText.includes(text)) {
                        show = false;
                    }

                    card.style.display = show ? "" : "none";
                });
            }

            btnSearch.addEventListener("click", function () {
                applyFilter();
                suggestionBox.innerHTML = "";
                suggestionBox.style.display = "none";
            });

            function buildSuggestions() {
                const query = normalize(txtSearch.value);

                if (!query || query.length < 2) {
                    suggestionBox.innerHTML = "";
                    suggestionBox.style.display = "none";
                    return;
                }

                const suggestionsSet = new Set();

                cards.forEach(card => {
                    const rawDest = card.dataset.destination || "";
                    const rawCatName = card.dataset.categoryname || "";

                    const destLower = normalize(rawDest);
                    const catLower = normalize(rawCatName);

                    if (destLower.includes(query)) {
                        suggestionsSet.add(rawDest);
                    }

                    if (catLower.includes(query)) {
                        suggestionsSet.add(rawCatName);
                    }

                    if (rawDest && rawCatName &&
                        (destLower.includes(query) || catLower.includes(query))) {
                        suggestionsSet.add(`${rawDest}, ${rawCatName}`);
                    }
                });

                const suggestions = Array.from(suggestionsSet).slice(0, 8);

                if (suggestions.length === 0) {
                    suggestionBox.innerHTML = "";
                    suggestionBox.style.display = "none";
                    return;
                }

                suggestionBox.innerHTML = "";
                suggestions.forEach(s => {
                    const div = document.createElement("div");
                    div.className = "search-suggestions-item";
                    div.dataset.value = s;
                    div.textContent = s;
                    suggestionBox.appendChild(div);
                });
                suggestionBox.style.display = "block";
            }

            txtSearch.addEventListener("input", function () {
                buildSuggestions();
            });

            suggestionBox.addEventListener("click", function (e) {
                const item = e.target.closest(".search-suggestions-item");
                if (!item) return;

                const label = item.dataset.value || "";
                txtSearch.value = label;
                suggestionBox.innerHTML = "";
                suggestionBox.style.display = "none";
            });
        });
    </script>
}
