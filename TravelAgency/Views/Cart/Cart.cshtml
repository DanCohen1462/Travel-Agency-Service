@model TravelAgency.Models.CartViewModel
@{
    ViewData["Title"] = "Your Cart";
    Layout = "_Layout";
    //int total = Model.Items.Sum(i => i.TotalSum); // totalSum כבר כולל numPersons
    int total = Model.Items?.Sum(i => i.TotalSum) ?? 0;

}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold m-0">Your Cart</h2>
        <a asp-controller="Package" asp-action="Gallery" class="btn btn-outline-secondary">
            Continue browsing
        </a>
    </div>

 
    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger">@TempData["CartError"]</div>
    }

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="alert alert-info">Your cart is empty.</div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-8">

                @foreach (var it in Model.Items)
                {
                    <div class="card shadow-sm" style="border-radius:16px;">
                        <div class="card-body">
                            <div class="d-flex gap-3">
                                <img src="@it.ImageUrl" style="width:140px;height:95px;object-fit:cover;border-radius:12px;" />

                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="fw-bold mb-1">
                                                @it.Destination@if (!string.IsNullOrWhiteSpace(it.Country)) {<text>, @it.Country</text>}
                                            </h5>

                                            <div class="text-muted" style="font-size:14px;">
                                                @it.StartDate.ToString("dd/MM/yyyy") – @it.EndDate.ToString("dd/MM/yyyy")
                                            </div>
                                        </div>

                                        <!-- X remove -->
                                        <form method="post" asp-controller="Cart" asp-action="RemoveRow" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="rowId" value="@it.ShoppingCartRowId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">✕</button>
                                        </form>

                                    </div>

                                    <div class="mt-2 d-flex flex-wrap gap-3">
                                        <div><strong>Passengers:</strong> @it.Quantity</div>
                                        <div><strong>Price per person:</strong> $@it.Price</div>
                                       

                                        <div>
                                            <strong>Reserved for:</strong>
                                            <span class="cart-timer text-danger fw-bold"
                                                  data-exp-ms="@(new DateTimeOffset(DateTime.SpecifyKind(it.ExpiresAt, DateTimeKind.Utc)).ToUnixTimeMilliseconds())">--:--</span>




                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm" style="border-radius:16px;">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Order Summary</h5>

                        <div class="d-flex justify-content-between align-items-center">
                            <span>Total</span>
                            <span class="fw-bold">$@total</span>
                        </div>

                        @if (total <= 0)
                        {
                            <button class="btn btn-secondary w-100 mt-3 fw-bold" disabled>
                                Proceed to Payment
                            </button>
                            <div class="text-muted mt-2" style="font-size:13px;">
                                Add at least one trip to your cart to continue.
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Cart" asp-action="Payment"
                               class="btn btn-primary w-100 mt-3 fw-bold">
                                Proceed to Payment
                            </a>
                        }
                        
                    </div>
                </div>
            </div>

        </div>
    }
</div>
@section Scripts {
    <script>
        (function () {
            function pad(n) { return n.toString().padStart(2, '0'); }

            let cleaning = false;

            async function expireOnServer() {
                if (cleaning) return;
                cleaning = true;

                try {
                    const res = await fetch('/Cart/ExpireNow', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (res.ok) {
                        const data = await res.json();
                        // אם משהו נמחק — מרעננים את העמוד כדי להוריד את הפריטים + totals + badges
                        if (data.removed && data.removed > 0) {
                            location.reload();
                            return;
                        }
                    }
                } catch (e) {
                    // שקט - לא להפיל את העמוד
                } finally {
                    cleaning = false;
                }
}
            
            function tick() {
                document.querySelectorAll('.cart-timer').forEach(el => {
                    const msStr = el.getAttribute('data-exp-ms');
                    if (!msStr) return;

                    const expMs = parseInt(msStr, 10);
                    if (isNaN(expMs)) return;

                    const diff = expMs - Date.now();


                    if (diff <= 0) {
                        el.textContent = "00:00";
                        el.classList.add("text-danger");
                        expireOnServer();
                        return;
                    }

                    const sec = Math.floor(diff / 1000);

                    const hh = Math.floor(sec / 3600);
                    const mm = Math.floor((sec % 3600) / 60);
                    const ss = sec % 60;

                    el.textContent = (hh > 0)
                        ? pad(hh) + ":" + pad(mm) + ":" + pad(ss)
                        : pad(mm) + ":" + pad(ss);

                });
            }

            tick();
            setInterval(tick, 1000);
        })();
    </script>
}
