@model TravelAgency.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<style>
    body { background-color: #f0f2f5; }

    .page-header {
        background: linear-gradient(135deg, #1C6DD0, #00C9A7);
        padding: 3rem 0;
        color: white;
        margin-bottom: 1rem;
        border-radius: 0 0 20px 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .content-wrap { margin-top: -0.5rem; }

    .btn-purple {
        background: #5A189A;
        color: #fff !important;
        border: 1px solid #5A189A;
        text-decoration: none !important;
        white-space: nowrap;
    }
    .btn-purple:hover{
        background: #4B147F;
        border-color: #4B147F;
    }
</style>


<div class="page-header text-center">
    <div class="container">
        <h1 class="fw-bold display-5">Change Password</h1>
        <p class="opacity-75 lead">Keep your account secure by updating your password</p>
    </div>
</div>

<div class="container pb-5 content-wrap">
    

    <form asp-controller="Auth" asp-action="ChangePassword" method="post"
          class="card border-0 shadow-lg rounded-4 p-4 p-md-5 mx-auto" style="max-width: 700px;">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label"></label>
            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>



        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

      
        <div class="d-flex flex-column gap-2 mt-4" style="max-width:360px; margin-left:auto;">
            <a asp-controller="Users" asp-action="Profile" class="btn btn-purple w-100">
                Back to Profile
            </a>

            <button type="submit" class="btn btn-purple w-100 shadow-sm">
                Update Password
            </button>
        </div>


    </form>


</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}