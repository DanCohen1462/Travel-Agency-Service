@model TravelAgency.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 class="mb-4">Change Password</h2>

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">@ViewBag.Success</div>
    }

    <form asp-controller="Auth" asp-action="ChangePassword" method="post"
          class="card p-4" style="max-width: 700px;">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label"></label>
            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <!-- ✅ buttons one under another + same color -->
        <div class="d-flex flex-column gap-2 mt-4" style="max-width:360px; margin-left:auto;">
            <a asp-controller="Users" asp-action="Profile" class="btn btn-outline-primary w-100">
                Back to Profile
            </a>

            <button type="submit" class="btn btn-primary w-100 shadow-sm">
                Update Password
            </button>
        </div>

    </form>


</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}