@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script>
  (function () {
    // 1) before submit - remember scroll ONLY for forms that request it
    document.addEventListener('submit', function (e) {
      try {
        const form = e.target;
        if (!form || !form.hasAttribute || !form.hasAttribute('data-keep-scroll')) return;

        sessionStorage.setItem('keepScroll', '1');
        sessionStorage.setItem('scrollY', String(window.scrollY || 0));
      } catch (err) {}
    }, true);

    // 2) after page load - restore scroll ONLY if it was requested
    window.addEventListener('load', function () {
      try {
        const keep = sessionStorage.getItem('keepScroll');
        if (keep !== '1') return;

        const y = parseInt(sessionStorage.getItem('scrollY') || "0");
        if (y > 0) window.scrollTo(0, y);

        sessionStorage.removeItem('keepScroll');
        sessionStorage.removeItem('scrollY');
      } catch (err) {}
    });
  })();
</script>

