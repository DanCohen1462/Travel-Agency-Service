 @using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>TravelAgency</title>


    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="icon" type="image/png" href="@Url.Content("~/icons/airplane.png")" />
    <link rel="stylesheet" href="~/TravelAgency.styles.css" asp-append-version="true"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-custom mb-3">
        <div class="container">
            

            @{
                var logoUserType = HttpContextAccessor.HttpContext?.Session.GetString("UserType");

                string logoController = "Home";
                string logoAction = "Index";

                if (logoUserType == "2")
                {
                    logoController = "Employee";
                    logoAction = "EmployeeDashboard";
                }
                else if (logoUserType == "1")
                {
                    logoController = "Admin";
                    logoAction = "Index";
                }
                else if (logoUserType == "3")
                {
                    logoController = "Users";
                    logoAction = "Dashboard";
                }
                
            }

            <a class="navbar-brand d-flex align-items-center gap-2"
               asp-controller="@logoController" asp-action="@logoAction">
                <span class="fw-bold">TravelAgency</span>

                <img src="@Url.Content("~/icons/airplane.png")"
                     alt="Logo"
                     style="height:26px;width:auto;display:inline-block;vertical-align:middle;" />



            </a>


            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            @{
                var userId = HttpContextAccessor.HttpContext?.Session.GetString("UserId");
                // שליפת סוג המשתמש (1=Admin, 2=Employee, 3=Customer)
                var userType = HttpContextAccessor.HttpContext?.Session.GetString("UserType"); 

                var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName")
                               ?? HttpContextAccessor.HttpContext?.Session.GetString("Username")
                               ?? "";
                var cartCount = HttpContextAccessor.HttpContext?.Session.GetInt32("CartCount") ?? 0;
                var notifCount = HttpContextAccessor.HttpContext?.Session.GetInt32("NotifCount") ?? 0;

            }

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    
                    @if (string.IsNullOrEmpty(userId))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="AboutUs">About Us</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ContactUs">Contact Us</a></li>
                    }
                    else
                    {
                        // בדיקה: איזה סוג משתמש זה?

                        if (userType == "2") 
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Package" asp-action="MyManagedPackages">
                                    My Packages
                                </a>
                            </li>

                            // 2. הודעות
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Notifications" asp-action="Index">
                                    Notifications
                                    <span class="notifBadge badge rounded-pill bg-danger ms-2"
                                          style="display:@(notifCount > 0 ? "inline-block" : "none")">
                                        @notifCount
                                    </span>


                                </a>
                            </li>



                            // 3. יצירת קשר
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="ContactUs">
                                    Contact Us
                                </a>
                            </li>
                            
                            // 4. פרופיל
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Users" asp-action="Profile">
                                    Profile
                                </a>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Package" asp-action="SearchStart">Search Trip</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="MyTrips">My Trips</a></li>

                        }
                        else if (userType == "1")
                        {
                            <li class="nav-item"><a class="nav-link text-danger" asp-controller="Admin" asp-action="index">Admin Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Packages">Manage Packages</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">Manage Users</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="CreatePackage">new Package</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="AssignGuide">Manage Guide</a></li>
                            
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="MyTrips">My Trips</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Profile">Profile</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Package" asp-action="SearchStart">Search Trip</a></li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Notifications" asp-action="Index">
                                    Notifications
                                    <span class="notifBadge badge rounded-pill bg-danger ms-2"
                                          style="display:@(notifCount > 0 ? "inline-block" : "none")">
                                        @notifCount
                                    </span>

                                </a>
                            </li>


                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ContactUs">Contact Us</a></li>
                        }
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    @if (string.IsNullOrEmpty(userId))
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-primary" asp-controller="Auth" asp-action="Login">Login</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-3">
                            <a class="nav-link d-flex align-items-center" asp-controller="Cart" asp-action="Cart">
                                <span class="me-1">&#128722;</span> Cart
                                <span id="cartBadge" class="badge rounded-pill bg-danger ms-1"
                                      style="display:@(cartCount > 0 ? "inline-block" : "none")">
                                    @cartCount
                                </span>

                            </a>

                        </li>

                        <li class="nav-item me-3">
                            <span class="navbar-text">Hello @fullName!</span>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-outline-danger" asp-controller="Auth" asp-action="Logout">Logout</a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="footer-custom">
    <div class="container">
        
        @{
            // --- לוגיקה לקביעת הקישורים בפוטר ---
            
            // 1. שליפת נתונים מה-Session
            var fUserId = HttpContextAccessor.HttpContext?.Session.GetString("UserId");
            var fUserType = HttpContextAccessor.HttpContext?.Session.GetString("UserType");

            // 2. קביעת הקישור של "Home" בהתאם לסוג המשתמש
            string fHomeController = "Home";
            string fHomeAction = "Index";

            if (fUserType == "2") // עובד
            {
                fHomeController = "Employee";
                fHomeAction = "EmployeeDashboard";
            }
            else if (fUserType == "3") // לקוח
            {
                fHomeController = "Users";
                fHomeAction = "Dashboard";
            }
            else if (fUserType == "1") // אדמין
            {
                fHomeController = "Admin";
                fHomeAction = "index"; // או Index, תלוי איך קראת לזה
            }
        }

        <div class="row">
            
            <div class="col-lg-4 col-md-6 mb-4">
                <h5 class="text-uppercase">TravelAgency</h5>
                <p class="small">
                    Your trusted partner for unforgettable journeys. 
                    We manage flights, hotels, and experiences to ensure 
                    your trip is perfect.
                </p>
                <div class="mt-3">
                    <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                </div>
            </div>

            <div class="col-lg-2 col-md-6 mb-4">
                <h5>Quick Links</h5>
                <ul class="list-unstyled">
                    <li>
                        <a asp-controller="@fHomeController" asp-action="@fHomeAction" class="footer-link">Home</a>
                    </li>
                    
                    <li><a asp-controller="Home" asp-action="AboutUs" class="footer-link">About Us</a></li>
                    <li><a asp-controller="Package" asp-action="Gallery" class="footer-link">Destinations</a></li>
                    <li><a asp-controller="Home" asp-action="ContactUs" class="footer-link">Contact</a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-6 mb-4">
                <h5>Account</h5>
                <ul class="list-unstyled">
                    
                    @if (string.IsNullOrEmpty(fUserId))
                    {
                        // --- מצב אורח: הצג התחברות והרשמה ---
                        <li><a asp-controller="Auth" asp-action="Login" class="footer-link">Login</a></li>
                        <li><a asp-controller="Auth" asp-action="Register" class="footer-link">Register</a></li>
                    }
                    else
                    {
                        // --- מצב מחובר: הצג פרופיל והתנתקות ---
                        <li>
                            <span class="text-muted small mb-2 d-block">You are logged in</span>
                        </li>
                        <li><a asp-controller="Users" asp-action="Profile" class="footer-link">My Profile</a></li>
                        <li><a asp-controller="Auth" asp-action="Logout" class="footer-link text-danger">Logout</a></li>
                    }
                    
                </ul>
            </div>

            <div class="col-lg-4 col-md-6 mb-4">
                <h5>Contact Us</h5>
                <ul class="list-unstyled small">
                    <li class="mb-2"><i class="fas fa-map-marker-alt me-2 text-primary"></i> Tel Aviv, Israel</li>
                    <li class="mb-2"><i class="fas fa-phone me-2 text-primary"></i> +972 3-123-4567</li>
                    <li class="mb-2"><i class="fas fa-envelope me-2 text-primary"></i> support@travel.com</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom text-center">
            <div class="row">
                <div class="col-md-6 text-md-start">
                    &copy; @DateTime.Now.Year <strong>TravelAgency</strong>. All Rights Reserved.
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-controller="Home" asp-action="Privacy" class="footer-link d-inline me-3">Privacy</a>
                </div>
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>


<script>
    async function pollBadgesOnly() {
        try {
            const res = await fetch('/Cart/BadgeCounts', {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) return;

            const data = await res.json();

            // update cart badge
            const cartBadge = document.getElementById('cartBadge');
            if (cartBadge && typeof data.cartCount === 'number') {
                if (data.cartCount > 0) {
                    cartBadge.style.display = 'inline-block';
                    cartBadge.textContent = data.cartCount;
                } else {
                    cartBadge.style.display = 'none';
                    cartBadge.textContent = '';
                }
            }

            // ✅ update notifications badge (יכול להיות שיש כמה)
            document.querySelectorAll('.notifBadge').forEach(nb => {
                if (nb && typeof data.notifCount === 'number') {
                    if (data.notifCount > 0) {
                        nb.style.display = 'inline-block';
                        nb.textContent = data.notifCount;
                    } else {
                        nb.style.display = 'none';
                        nb.textContent = '';
                    }
                }
            });

        } catch (e) {
            // silent
        }
    }

    pollBadgesOnly();               // ✅ ריצה פעם אחת מיד
    setInterval(pollBadgesOnly, 5000);
</script>



<!-- ✅ Toasts container: top-right under navbar -->
<div id="toastArea"
     style="position:fixed; top:90px; right:24px; z-index:99999;
            display:flex; flex-direction:column; gap:10px; min-width:320px;">
</div>
<script>
    function showToast(msg, kind) {
        const area = document.getElementById("toastArea");
        if (!area) return;

        const div = document.createElement("div");

        // צבע פס צד לפי סוג
        let accent = "#175CD3"; // info default
        let icon = "ℹ️";

        if (kind === "success") { accent = "#1A7F37"; icon = "✅"; }
        if (kind === "error")   { accent = "#B42318"; icon = "⚠️"; }
        if (kind === "warning") { accent = "#B54708"; icon = "⚠️"; }

        div.style.cssText =
            "background:#FFFFFF; color:#111827; padding:14px 16px; border-radius:14px;" +
            "border:1px solid #E5E7EB; box-shadow:0 10px 24px rgba(0,0,0,0.12);" +
            "display:flex; gap:10px; align-items:flex-start;" +
            "border-right:6px solid " + accent + ";";

        div.innerHTML =
            `<div style="font-size:18px;line-height:1;margin-top:1px;">${icon}</div>` +
            `<div style="font-weight:700;">${msg}</div>`;

        area.appendChild(div);
        setTimeout(() => div.remove(), 2500);
    }
</script>


@if (TempData["BookToast"] != null)
{
    <script>
        showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["BookToast"])), "success");
    </script>
}
