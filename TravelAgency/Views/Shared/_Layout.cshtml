 @using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TravelAgency</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/TravelAgency.styles.css" asp-append-version="true"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-custom mb-3">
        <div class="container">

            @{
                // בדיקה מהירה: מי המשתמש, כדי לדעת לאן הלוגו צריך לקחת אותו
                var logoUserType = HttpContextAccessor.HttpContext?.Session.GetString("UserType");
            }

            @if (logoUserType == "2")
            {
                <a class="navbar-brand fw-bold" asp-controller="Employee" asp-action="EmployeeDashboard">
                    TravelAgency
                </a>
            }
            else
            {
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    TravelAgency
                </a>
            }

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            @{
                var userId = HttpContextAccessor.HttpContext?.Session.GetString("UserId");
                // שליפת סוג המשתמש (1=Admin, 2=Employee, 3=Customer)
                var userType = HttpContextAccessor.HttpContext?.Session.GetString("UserType"); 

                var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName")
                               ?? HttpContextAccessor.HttpContext?.Session.GetString("Username")
                               ?? "";
                var cartCount = HttpContextAccessor.HttpContext?.Session.GetInt32("CartCount") ?? 0;
            }

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    
                    @if (string.IsNullOrEmpty(userId))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="AboutUs">About Us</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ContactUs">Contact Us</a></li>
                    }
                    else
                    {
                        // בדיקה: איזה סוג משתמש זה?

                        if (userType == "2") 
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Package" asp-action="MyManagedPackages">
                                    My Packages
                                </a>
                            </li>

                            // 2. הודעות
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                                    Notifications
                                </a>
                            </li>

                            // 3. יצירת קשר
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="ContactUs">
                                    Contact Us
                                </a>
                            </li>
                            
                            // 4. פרופיל
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Users" asp-action="Profile">
                                    Profile
                                </a>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Package" asp-action="Gallery">Search Trip</a></li>
                        }
                        else if (userType == "1")
                        {
                            <li class="nav-item"><a class="nav-link text-danger" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a></li>
                             <li class="nav-item"><a class="nav-link" asp-controller="Package" asp-action="Index">Manage Packages</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="MyTrips">My Trips</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Profile">Profile</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Package" asp-action="Gallery">Search Trip</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Notifications" asp-action="Index">Notifications</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="ContactUs">Contact Us</a></li>
                        }
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    @if (string.IsNullOrEmpty(userId))
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-primary" asp-controller="Auth" asp-action="Login">Login</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-3">
                            <a class="nav-link d-flex align-items-center" asp-controller="Cart" asp-action="Index">
                                <span class="me-1">&#128722;</span> Cart
                                <span class="badge rounded-pill bg-danger ms-1">@cartCount</span>
                            </a>
                        </li>

                        <li class="nav-item me-3">
                            <span class="navbar-text">Hello @fullName!</span>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-outline-danger" asp-controller="Auth" asp-action="Logout">Logout</a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2025 - TravelAgency - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>